ِهِ اللَّيْلَةِ وَخَيْرَ مَا بَعْدَهَا وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِي هَذِهِ اللَّيْلَةِ وَشَرَّ مَا بَعْدَهَا رَبِّ أَعُوذُ بِكَ مِنَ الكَسَلِ وَسُوءِ الكِبَرِ، رَبَّ أَعُوذُ بِكَ مِنْ عَذَابٍ فِي النَّارِ وَعَذَابٍ فِي القَبْرِ","c":1,"r":"مسلم 4/ 2088"},{"t":"اللَّهُمَّ بِكَ أَمْسَيْنَا وَبِكَ أَصْبَحْنَا وَبِكَ نَحْيَا وَبِكَ نَمُوتُ وَإِلَيْكَ المَصِيرُ","c":1,"r":"التّرمذي 5/ 466 وانظر صحيح التّرمذي 3/ 142"},{"t":"اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُك، وَأَنَا عَلَى عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ بِذَنْبِي، فَاغْفِرْ لِي فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ","c":1,"r":"من قالها موقنًا بها حين يمسي فمات من ليلته دخل الجنة، وكذلك إذا أصبح أخرجه البخاري 7/ 150"},{"t":"اللَّهُمَّ إِنِّي أَمْسَيْتُ أُشْهِدُكَ وَأُشْهِدُ حَمَلَةَ عَرْشِكَ، وَمَلَائِكَتَكَ وَجَمِيعَ خَلْقِكَ، أَنَّكَ أَنْتَ اللَّهُ لَا إِلَهَ إِلَّا أَنْتَ وَحْدَكَ لَا شَرِيكَ لَكَ، وَأَنَّ مُحَمَّدًا عَبْدُكَ وَرَسُولُكَ","c":4,"r":"من قالها حين يصبح وحين يمسي أربع مرات أعتقه الله من النار . أخرجه أبو داود 4/ 317 والبخاري في الأدب المفرد برقم 1201 والنسائي في عمل اليوم والليلة برقم 9، وابن السني برقم 70 وحسن سماحة الشيخ ابن باز إسناد النسائي وأبي داود في تحفة الأخيار ص 23"},{"t":"اللَّهُمَّ مَا أَمْسَى بِي مِنْ نِعْمَةٍ أَوْ بِأَحَدٍ مِنْ خَلْقِكَ فَمِنْكَ وَحْدَكَ لَا شَرِيكَ لَكَ، فَلَكَ الحَمْدُ وَلَكَ الشُّكْرُ","c":1,"r":"من قالها حين يصبح فقد أدي شكر يومه، ومن قالها حين يمسى فقد أدى شكر ليلته. أخرجه أبو داود 4/ 318، والنسائي في عمل اليوم والليلة برقم 7 وابن السني برقم 41 وابن حبان \"موارد\"رقم 2361 وحسن ابن باز إسناده في تحفة الأخيار ص 24"},{"t":"اللَّهُمَّ عَافِنِي فِي بَدَنِي، اللَّهُمَّ عَافِنِي فِي سَمْعِي، اللَّهُمَّ عَافِنِي فِي بَصَرِي، لَا إِلَه إِلَّا أَنْتَ. اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الكُفْرِ، وَالفَقْرِ، وَأَعُوذُ بِكَ مِنْ عَذَابِ القَبْرِ، لَا إِلَهَ إِلَّا أَنْتَ","c":3,"r":"أبو داود 4/ 324، وأحمد 5/ 42 والنسائي في عمل اليوم والليلة برقم 22 وابن السني برقم 69 والبخاري في الأدب المفرد، وحسن العلامة ابن باز إسناده في تحفة الأخيار ص 26"},{"t":"حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ العَرْشِ العَظِيمِ","c":7,"r":"من قالها حين يصبح ويمسي سبع مرات كفاه الله ما أهمه من أمر الدنيا والآخرة. أخرجه ابن السني برقم 71 مرفوعًا وأبو موقوف 4/ 321، وصحح إسناده شعيب وعبد القادر الأرناؤوط. انظر زاد المعاد 2/ 376"},{"t":"اللَّهُمَّ إِنِّي أَسْأَلُكَ العَفْوَ وَالعَافِيَةَ فِي الدُّنْيَا وَالآخِرَةِ، اللَّهُمَّ إِنِّي أَسْأَلُكَ العَفْوَ وَالعَافِيَةَ فِي دِينِي وَدُنْيَايَ وَأَهْلِي وَمَالِي، اللَّهُمَّ اسْتُرْ عَوْرَاتِي وَآمِنْ رَوْعَاتِي، اللَّهُمَّ احْفَظْنِي مِنْ بَيْنِ يَدَيَّ وَمِنْ خَلْفِي وَعَنْ يَمِينِي وَعَنْ شِمَالِي وَمِنْ فَوْقِي وَأَعُوذُ بِعَظَمَتِكَ أَنْ أُغْتَالَ مِنْ تَحْتِي","c":1,"r":"أبو داود وابن ماجه وانظر صحيح ابن ماجه 2/ 332"},{"t":"اللَّهُمَّ عَالِمَ الغَيْبِ وَالشَّهَادَةِ، فَاطِرَ السَّمَوَاتِ وَالأَرْضِ، رَبَّ كُلِّ شَيْءٍ وَمَلِيكَهُ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ أَعُوذُ بِكَ مِنْ شَرِّ نَفْسِي وَمِنْ شَرِّ الشَّيْطَانِ وَشِرْكِهِ وَأَنْ أَقْتَرِفَ عَلَى نَفْسِي سُوءًا أَوْ أَجُرَّهُ إِلَى مُسْلِمٍ","c":1,"r":"التّرمذي وأبو داود .انظر :صحيح التّرمذي 3/ 142"},{"t":"بِسْمِ اللَّهِ الذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ العَلِيمُ","c":3,"r":"من قالها ثلاثًا إذا أصبح وثلاثًا إذا أمسى لم يضره شيء أخرجه أبو داود 4/ 323 والتّرمذي 5/ 465 وابن ماجه وأحمد. انظر: صحيح ابن ماجه 2/ 332 وحسن إسناده العلامة ابن باز في تحفة الأخيار ص 39"},{"t":"رَضِيتُ بِاللَّهِ رَبًّا، وَبِالإِسْلَامِ دِينًا وَبِمُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَبِيًّا","c":3,"r":"من قالها ثلاثًا حين يصبح وحين يمسي كان حقًا على الله أن يرضيه يوم القيامة. أحمد 4/ 337 والنسائي في عمل اليوم والليلة برقم 4 وابن السني برقم 68 وأبو داود 4/ 418 والتّرمذي 5/ 465 وحسنه ابن باز في تحفة الأخيار ص 39"},{"t":"يَا حَيُّ يَا قَيُّومُ بِرَحْمَتِكَ أَسْتَغِيثُ أَصْلِحْ لِي شَأْنِي كُلَّهُ وَلَا تَكِلْنِي إِلَى نَفْسِي طَرْفَةَ عَيْنٍ","c":1,"r":"الحاكم وصححه ووافقه الذهبي 1/ 545 وانظر صحيح الترغيب والترهيب 1/ 273"},{"t":"أَمْسَيْنَا وَأَمْسَى المُلْكُ لِلَّهِ رَبِّ العَالَمِينَ، اللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَ هَذِهِ اللَّيْلَةِ: فَتْحَهَا، وَنَصْرَهَا، وَنُورَهَا، وَبَرَكَتَهَا، وَهُدَاهَا، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِيهَا وَشَرِّ مَا بَعْدَهَا","c":1,"r":"أبو داود 4/ 322 وحسن إسناده شعيب وعبد القادر الأرناؤوط في تحقيق زاد المعاد 2/ 273"},{"t":"أَمْسَيْنَا عَلَى فِطْرَةِ الإِسْلَامِ وَعَلَى كَلِمَةِ الإِخْلَاصِ، وَعَلَى دِينِ نَبِيِّنَا مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ، وَعَلَى مِلَّةِ أَبِينَا إِبْرَاهِيمَ حَنِيفًا مُسْلِمًا وَمَا كَانَ مِنَ المُشْرِكِينَ","c":1,"r":"أحمد 3/ 406 و 407 وابن السني في عمل اليوم والليلة برقم 34 وانظر: صحيح الجامع 4/ 209"},{"t":"سُبْحَانَ اللَّهِ وَبِحَمْدِهِ","c":100,"r":"من قالها مائة مرة حين يصبح وحين يمسي لم يأت أحد يوم القيامة بأفضل مما جاء به إلا أحد قال مثل ما قال أو زاد رواه مسلم 4/ 2071"},{"t":"لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ المُلْكُ وَلَهُ الحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","c":10,"r":"عَشرَ مَرَّاتٍ:\r\n النسائي في عمل اليوم والليلة برقم 24 وانظر :صحيح الترغيب والترهيب 1/ 272، وتحفة الأخيار لابن باز ص 44 وانظر فضلها في ص 146، حديث رقم 255\r\n\r\nأو مرة واحدة عند الكسل\r\nأبو داود 4/ 319 وابن ماجه وأحمد 4/ 60 وانظر :صحيح الترغيب والترهيب 1/ 270، صحيح أبو داود 3/ 957، وصحيح ابن ماجه 2/ 331 وزاد المعاد 2/ 377"},{"t":"أَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ","c":100,"r":"البخاري مع الفتح 11/ 101، ومسلم 4/ 2075"},{"t":"أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ","c":3,"r":"من قالها حين يمسي ثلاث مرات لم تضره حمة تلك الليلة أخرجه أحمد 2/ 290 والنسائي في عمل اليوم والليلة برقم 590 وابن السني برقم 68 وانظر: صحيح التّرمذي 3/ 187، وصحيح ابن ماجه 2/ 266 وتحفة الأخيار ص 45"},{"t":"اللَّهُمَّ صَلِّ وَسَلِّمْ عَلَى نَبِيِّنَا مُحَمَّدٍ","c":10,"r":"من صلى علي حين يُصبح عشرًا، وحين يُمسي عشرًا أدركتهُ شفاعتي يوم القيامة\r\nأخرجه الطبراني بإسنادين أحدهما جيد، انظر: الزوائد 10/ 120 وصحيح الترغيب والترهيب 1/ 273"}]},{"i":28,"t":"أَذْكَارُ النَّوْمِ","a":[{"t":"يَجْمَعُ كَفَّيْهِ ثُمَّ يَنْفُثُ فِيهِمَا، فَيَقْرَأُ فِيهِمَا:\r\n\r\nبِسْمِ اللَّهِ الرَّحْمِنِ الرَّحِيمِ\r\n{قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ * لَمْ يَلِدْ وَلَمْ يُولَدْ * وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ}\r\n\r\nبِسْمِ اللَّهِ الرَّحْمِنِ الرَّحِيمِ\r\n{قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ * مِن شَرِّ مَا خَلَقَ * وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ * وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ * وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ}\r\n\r\nبِسْمِ اللَّهِ الرَّحْمِنِ الرَّحِيمِ\r\n{قُلْ أَعُوذُ بِرَبِّ النَّاسِ * مَلِكِ النَّاسِ * إِلَهِ النَّاسِ * مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ * الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ * مِنَ الْجِنَّةِ وَالنَّاسِ}\r\n\r\nثُمَّ يَمْسَحُ بِهِمَا مَا اسْتَطَاعَ مِنْ جَسَدِهِ يَبْدَأُ بِهِمَا عَلَى رَأْسِهِ وَوَجْهِهِ وَمَا أَقْبَلَ مِنْ جَسَدِهِ","c":3,"r":"البخاري مع الفتح 9/ 62 ومسلم 4/ 1723"},{"t":"أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ\r\n{اللّهُ لاَ إِلَـهَ إِلاَّ هُوَ الْحَيُّ الْقَيُّومُ لاَ تَأْخُذُهُ سِنَةٌ وَلاَ نَوْمٌ لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الأَرْضِ مَن ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلاَّ بِإِذْنِهِ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلاَ يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلاَّ بِمَا شَاء وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالأَرْضَ وَلاَ يَؤُودُهُ حِفْظُهُمَا وَهُوَ الْعَلِيُّ الْعَظِيمُ}","c":1,"r":"من قرأها إذا أوى إلى فراشه فإنه لن يزال عليه من الله حافظ ولا يقربه شيطان حتى يصبح البخاري مع الفتح 4/ 487"},{"t":"أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ\r\n{آمَنَ الرَّسُولُ بِمَا أُنزِلَ إِلَيْهِ مِن رَّبِّهِ وَالْمُؤْمِنُونَ كُلٌّ آمَنَ بِاللّهِ وَمَلآئِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ لاَ نُفَرِّقُ بَيْنَ أَحَدٍ مِّن رُّسُلِهِ وَقَالُواْ سَمِعْنَا وَأَطَعْنَا غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ الْمَصِيرُ * لاَ يُكَلِّفُ اللّهُ نَفْسًا إِلاَّ وُسْعَهَا لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ رَبَّنَا لاَ تُؤَاخِذْنَا إِن نَّسِينَا أَوْ أَخْطَأْنَا رَبَّنَا وَلاَ تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِن قَبْلِنَا رَبَّنَا وَلاَ تُحَمِّلْنَا مَا لاَ طَاقَةَ لَنَا بِهِ وَاعْفُ عَنَّا وَاغْفِرْ لَنَا وَارْحَمْنَا أَنتَ مَوْلاَنَا فَانصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ}","c":1,"r":"من قرأهما في ليلة كفتاه، البخاري مع الفتح 9/ 94 ومسلم 1/ 554، والآيتان من سورة البقرة، 285 – 286"},{"t":"بِاسْمِكَ رَبِّي وَضَعْتُ جَنْبِي وَبِكَ أَرْفَعُهُ، إِنْ أَمْسَكْتَ نَفْسِي فَارْحَمْهَا، وَإِنْ أَرْسَلْتَهَا فَاحْفَظْهَا بِمَا تَحْفَظُ بِهِ عِبَادَكَ الصَّالِحِينَ","c":1,"r":"إذا قام أحدكم من فراشه ثم رجع إليه فلينفض بصنفة  إزاره ثلاث مرات وليسم الله  فإنه لا يدري ماذا خلفه عليه بعده وإذا اضطجع فليقل ... (الحديث)\r\n\r\n البخاري 11/ 126. ومسلم 4/ 2084"},{"t":"اللَّهُمَّ إِنَّكَ خَلَقْتَ نَفْسِي وَأَنْتَ تَوَفَّاهَا، لَكَ مَمَاتُهَا وَمَحْيَاهَا، إِنْ أَحْيَيْتَهَا فَاحْفَظْهَا، وَإِنْ أَمَتَّهَا فَاغْفِرْ لَهَا، اللَّهُمَّ إِنِّي أَسْأَلُكَ العَافِيَةَ","c":1,"r":"أخرجه مسلم 4/ 2083 وأحمد بلفظه 2/ 79"},{"t":"اللَّهُمَّ قِنِي عَذَابَكَ يَوْمَ تَبْعَثُ عِبَادَكَ","c":3,"r":"كان رسول الله صلى الله عليه وسلم إذا أراد أن يرقد وضع يده اليمنى تحت خده ثم يقول ... (الحديث)\r\n\r\nأبو داود بلفظه 4/ 311 وانظر صحيح التّرمذي 3/ 143"},{"t":"بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا","c":1,"r":"البخاري مع الفتح 11/ 113 ومسلم 4/ 2083"},{"t":"سُبْحَانَ اللَّهِ","c":33,"r":"من قال ذلك عندما يأوي إلى فراشه كان خيرًا له من خادم. البخاري مع الفتح 7/ 71 ومسلم 4/ 2091"},{"t":"الحَمْدُ لِلَّهِ","c":33,"r":"من قال ذلك عندما يأوي إلى فراشه كان خيرًا له من خادم. البخاري مع الفتح 7/ 71 ومسلم 4/ 2091"},{"t":"اللَّهُ أَكْبَرُ","c":34,"r":"من قال ذلك عندما يأوي إلى فراشه كان خيرًا له من خادم. البخاري مع الفتح 7/ 71 ومسلم 4/ 2091"},{"t":"اللَّهُمَّ رَبَّ السَّمَوَاتِ السَّبْعِ وَرَبَّ الأَرْضِ، وَرَبَّ العَرْشِ العَظِيمِ، رَبَّنَا وَرَبَّ كُلَّ شَيْءٍ، فَالِقَ الحَبِّ وَالنَّوَى، وَمُنْزِلَ التَّوْرَاةِ وَالِإنْجِيلِ، وَالفُرْقَانِ، أَعُوذُ بِكَ مِنْ شَرِّ كُلِّ شَيْءٍ أَنْتَ آخِذٌ بِنَاصِيَتِهِ، اللَّهُمَّ أَنْتَ الأَوَّلُ فَلَيْسَ قَبْلَكَ شَيْءٌ، وَأَنْتَ الآخِرُ فَلَيْسَ بَعْدَكَ شَيْءٌ، وَأَنْتَ الظَّاهِرُ فَلَيْسَ فَوْقَكَ شَيْءٌ، وَأَنْتَ البَاطِنُ فَلَيْسَ دُونَكَ شَيْءٌ، اقْضِ عَنَّا الدَّيْنَ وَاغْنِنَا مِنَ الفَقْرِ","c":1,"r":"مسلم 4/ 2084"},{"t":"الحَمْدُ لِلَّهِ الذِي أَطْعَمَنَا وَسَقَانَا وَكَفَانَا وَآوَانَا فَكَمْ مِمَّنْ لَا كَافِيَ لَهُ وَلَا مُؤْوِي","c":1,"r":"مسلم 4/ 2085"},{"t":"اللَّهُمَّ عَالِمَ الغَيْبِ وَالشَّهَادَةِ، فَاطِرَ السَّمَوَاتِ وَالأَرْضِ، رَبَّ كُلِّ شَيْءٍ وَمَلِيكَهُ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ، أَعُوذُ بِكَ مِنْ شَرِّ نَفْسِي، وَمِنْ شَرِّ الشَّيْطَانِ وَشَرَكِهِ، وَأَنْ أَقْتَرِفَ عَلَى نَفْسِي سُوءًا أَوْ أَجُرَّه إِلَى مُسْلِمٍ","c":1,"r":"أبو داود 4/ 317 وانظر صحيح سنن التّرمذي 3/ 142"},{"t":"يَقْرَأُ {ألم * تَنْزِيل ...} (سُورَةُ السَّجْدَة)\r\nوَ{تَبَارَكَ الذِي بِيَدِهِ المُلْكُ ...} (سُورَةُ المُلْكِ)","c":1,"r":"التّرمذي والنسائي وانظر صحيح الجامع 4/ 255"},{"t":"اللَّهُمَّ أَسْلَمْتُ نَفْسِي إِلَيْكَ، وَفَوَّضْتُ أَمْرِي إِلَيْكَ، وَوَجَّهْتُ وَجْهِي إِلَيْكَ، وَأَلْجَأْتُ ظَهْرِي إِلَيْكَ، رَهْبَةً وَرَغْبَةً إِلَيْكَ، لَا مَلْجَأَ وَلَا مَنْجَا مِنْكَ إِلَّا إِلَيْكَ، آمَنْتُ بِكِتَابِكَ الذِي أَنْزَلْتَ وَبِنَبِيِّكَ الذِي أَرْسَلْتَ","c":1,"r":"إذا أخذت مضجعك فتوضأ وضوءك للصلاة ثم اضطجع على شقك الأيمن، وقل: ... (الحديث)  قال صلى الله عليه وسلم لمن قال ذلك: فإن متَّ، متَّ على الفطرة البخاري مع الفتح 11/ 113 ومسلم 4/ 2081"}]},{"i":29,"t":"الدُّعَاءُ إِذَا تَقَلَّبَ لَيْلًا","a":[{"t":"لَا إِلَهِ إِلَّا اللَّهُ الوَاحِدُ القَهَّارُ، رَبُّ السَّمَوَاتِ وَالأَرْضِ وَمَا بَيْنَهُمَا العَزِيزُ الغَفَّارُ","c":1,"r":"يقول ذلك إذا تقلّب من جنب إلى جنب. أخرجه الحاكم وصححه ووافقه الذّهبي 1/ 540 والنّسائي في عمل اليوم والّيلة، وابن السّني، وانظر صحيح الجامع 4/ 213"}]},{"i":30,"t":"دُعَاءُ الفَزَعِ فِي النَّوْمِ وَمَنْ بُلِيَ بِالوَحْشَةِ","a":[{"t":"أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ غَضَبِهِ وَعِقَابِهِ، وَشَرِّ عِبَادِهِ، وَمِنْ هَمَزَاتِ الشَّيَاطِينِ وَأَنْ يَحْضُرُونِ","c":1,"r":"أبو داود 4/ 12 وانظر صحيح التّرمذي 3/ 171"}]},{"i":31,"t":"مَا يَفْعَلُ مَنْ رَأَى الرُّؤْيَا أَوِ الحُلُمَ","a":[{"t":"يَنْفُثُ عَنْ يَسَارِهِ","c":3,"r":"مسلم 4/ 1772"},{"t":"يَسْتَعِيذُ بِاللَّهِ مِنَ الشَّيْطَانِ وَمِنْ شَرِّ مَا رَأَى","c":3,"r":"مسلم 4/ 1772، 1773"},{"t":"لَا يُحَدِّثُ بِهَا أَحَدًا","c":1,"r":"مسلم 4/ 1772"},{"t":"يَتَحَوَّلَ عَنْ جَنْبِهِ الذِي كَانَ عَلَيْهِ","c":1,"r":"مسلم 4/ 1773"},{"t":"يَقُومُ يُصَلِّي إِنْ أَرَادَ ذَلِكَ","c":1,"r":"مسلم 4/ 1773"}]},{"i":32,"t":"دُعَاءُ قُنُوتِ الوِتْرِ","a":[{"t":"اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ، وَعَافِنِي فِيمَنْ عَافَيْتَ، وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ، وَبَارِكْ لِي فِيمَا أَعْطَيْتَ، وَقِنِي شَرَّ مَا قَضَيْتَ، فَإِنَّكَ تَقْضِي وَلَا يُقْضَى عَلَيْكَ، إِنَّهُ لَا يَذِلُّ مَنْ وَاَلَيْتَ، [وَلَا يَعِزُّ مَنْ عَادَيْتَ]، تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ","c":1,"r":"أخرجه أصحاب السّنن الأربعة، وأحمد والدّارمي والحاكم والبيهقيّ، ومابين المعكوفين للبيهقي، وانظر صحيح التّرمذي 1/ 144 وصحيح ابن ماجة 1/ 194 وإرواء الغليل للألباني 2/ 172"},{"t":"اللَّهُمَّ إِنِّي أَعُوذُ بِرِضَاكَ مِنْ سَخَطِكَ، وَبِمُعَافَاتِكَ مِنْ عُقُوبَتِكَ، وأَعُوذُ بِكَ مِنْكَ، لَا أُحْصِي ثَنَاءً عَلَيْكَ، أَنْتَ كَمَا أَثْنَيْتَ عَلَى نَفْسِكَ","c":1,"r":"أخرجه أصحاب السّنن الأربعة، وأحمد. انظر صحيح التّرمذي 3/ 180 وصحيح ابن ماجة 1/ 194، والإرواء 2/ 175"},{"t":"اللَّهُمَّ إِيَّاكَ نَعْبُدُ، وَلَكَ نُصَلِّي وَنَسْجُدُ، وَإِلَيْكَ نَسْعَى وَنَحْفِدُ، نَرْجُو رَحْمَتَكَ وَنَخْشَى عَذَابَكَ، إِنَّ عَذَابَكَ بِالكَافِرِينَ مُلْحَقٌ. اللَّهُمَّ إِنَّا نَسْتَعِينُكَ، وَنَسْتَغْفِرُكَ، وَنُثْنِي عَلَيْكَ الخَيْرَ، وَلَا نَكْفُرُكَ، وَنُؤْمِنُ بِكَ، وَنَخْضَعُ لَكَ، وَنَخْلَعُ مَنْ يَكْفُرُكَ","c":1,"r":"أخرجه البيهقيّ في السّنن الكبرى وصحح إسناده 2/ 211، وقال الشّيخ الألباني في إرواء الغليل: وهذا إسناده صحيح 2/ 170. وهو موقوف على عمر"}]},{"i":33,"t":"الذِّكْرُ عَقِبَ السَّلَامِ مِنَ الوِتْرِ","a":[{"t":"سُبْحَانَ المَلِكِ القُدُّوسِ. وَالثَّالِثَةُ يَجْهَرُ بِهَا وَيَمُدُّ بِهَا صَوْتَهُ يَقُولُ: [رَبِّ المَلَائِكَةِ وَالرُّوحِ]","c":3,"r":"رواه النّسائي 3/ 244 والدّاراقطني وغيرهما، وما بين المعكوفين زيادة للدّاراقطني 2/ 31 وإسناده صحيح. انظر زاد المعاد بتحقيق شعيب الأرناؤوط و عبد القادر الأرناؤوط 1/ 337"}]},{"i":34,"t":"دُعَاءُ الهَمِّ والحُزْنِ","a":[{"t":"اللَّهُمَّ إِنِّي عَبْدُكَ، اِبْنُ عَبْدِكَ، اِبْنُ أَمَتِكَ، نَاصِيَتِي بِيَدِكَ، مَاضٍ فِيَّ حُكْمُكَ، عَدْلٌ فِيَّ قَضَاؤُكَ، أَسْأَلُكَ بِكُلِّ اِسْمٍ هُوَ لَكَ، سَمَّيْتَ بِهِ نَفْسَكَ، أَوْ أَنْزَلْتَهُ فِي كِتَابِكَ، أَوْ عَلَّمْتَهُ أَحَدًا مِنْ خَلْقِكَ، أَوْ اِسْتَأْثَرْتَ بِهِ فِي عِلْمِ الغَيْبِ عِنْدَكَ، أَنْ تَجْعَلَ القُرْآنَ رَبِيعَ قَلْبِي، وَنُورَ صَدْرِي، وَجَلَاءَ حُزْنِي، وَذَهَابَ هَمِّي","c":1,"r":"أحمد 1/ 391 وصحّحه الألبانيّ"},{"t":"اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الهَمِّ وَالحَزَنِ، وَالعَجْزِ وَالكَسَلِ، وَالبُخْلِ وَالجُبْنِ، وَضَلَعِ الدَّيْنِ وَغَلَبَةِ الرِّجَالِ","c":1,"r":"البخاري 7/ 158، كان رسول اللّه صلّى اللّه عليه وسلّم يُكثِر من هذا الدّعاء. انظر البخاري مع الفتح 11/ 173"}]},{"i":35,"t":"دُعَاءُ الكَرْبِ","a":[{"t":"لَا إِلَهَ إِلَّا اللَّهُ العَظِيمُ الحَلِيمُ، لَا إِلَهَ إِلَّا اللَّهُ رَبُّ العَرْشِ العَظِيمِ، لَا إِلَهَ إِلَّا اللَّهُ رَبُّ السَّمَاوَاتِ وَرَبُّ الأَرْضِ وَرَبُّ العَرْشِ الكَرِيمِ","c":1,"r":"البخاري 7/ 154 ومسلم 4/ 2092"},{"t":"اللَّهُمَّ رَحْمَتَكَ أَرْجُو فَلَا تَكِلْنِي إِلَى نَفْسِي طَرْفَةَ عَيْنٍ، وَأَصْلِحْ لِي شَأْنِي كُلَّهُ، لَاإِلَهَ إِلَّا أَنْتَ","c":1,"r":"أبو داود 4/ 324 وأحمد 5/ 42 وحسّنه الألبانيّ في صحيح أبي داود 3/ 959"},{"t":"لَا إِلَهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ","c":1,"r":"التّرمذي 5/ 529، والحاكم، وصحّحه ووافقه الذّهبيّ 1/ 505، وانظر صحيح التّرمذي 3/ 168"},{"t":"اللَّهُ اللَّهُ رَبِّي لَا أُشْرِكُ بِهِ شَيْئًا","c":1,"r":"أخرجه أبو داود 2/ 87 وانظر صحيح ابن ماجة 2/ 335"}]},{"i":36,"t":"دُعَاءُ لِقَاءِ العَدُّوِّ وَذِي السُّلْطَانِ","a":[{"t":"اللَّهُمَّ إِنَّا نَجْعَلُكَ فِي نُحُورِهِمُ، وَنَعُوذُ بِكَ مِنْ شُرُورِهِمُ","c":1,"r":"أبو داود 2/ 89، وصحّحه الحاكم ووافقه الذّهبيّ 2/ 142"},{"t":"اللَّهُمَّ أَنْتَ عَضُدِي، وَأَنْتَ نَصِيرِي، بِكَ أَجُولُ، وَبِكَ أَصُولُ، وَبِكَ أُقَاتِلُ","c":1,"r":"أبو داود 3/ 42 والتّرمذي 5/ 572، وانظر صحيح التّرمذي 3/ 183"},{"t":"حَسْبُنَا اللَّهُ وَنِعْمَ الوَكِيلُ","c":1,"r":"البخاري 5/ 172"}]},{"i":37,"t":"دُعَاءُ مَنْ خَافَ ظُلْمَ السُّلْطَانِ","a":[{"t":"اللَّهُمَّ رَبَّ السَّمَاوَاتِ السَّبْعِ، وَرَبَّ العَرْشِ العَظِيمِ، كُنْ لِي جَارًا مِنْ فُلَانٍ بْنِ فُلَانٍ، وَأَحْزَابِهِ مِنْ خَلَائِقِكَ، أَنْ يَفْرُطَ عَلَيَّ أَحَدٌ مِنْهُمْ أَوْ يَطْغَى، عَزَّ جَارُكَ، وَجَلَّ ثَنَاؤُكَ، وَلَا إِلَهَ إِلَّا أَنْتَ","c":1,"r":"البخاري في الأدب المفرد برقم 707 وصحّحه الألبانيّ في صحيح الأدب المفرد برقم 545"},{"t":"اللَّهُ أَكْبَرُ، اللَّهُ أَعَزُّ مِنْ خَلْقِهِ جَمِيعًا، اللَّهُ أَعَزُّ مِمَّا أَخَافُ وَأَحْذَرُ، أَعُوذُ بِاللَّهِ الذِي لَا إِلَهَ إِلَّا هُوَ، المُمْسِكِ السَّمَاوَاتِ السَّبْعِ أَنْ يَقَعْنَ عَلَى الأَرْضِ إِلَّا بِإِذْنِهِ، مِنْ شَرِّ عَبْدِكَ فُلَانٍ، وَجُنُودِهِ وَأَتْبَاعِهِ وَأَشْيَاعِهِ، مِنَّ الجِنِّ وَالإِنْسِ، اللَّهُمَّ كُنْ لِي جَارًا مِنْ شَرِّهِمْ، جَلَّ ثَنَاؤُكَ وَعَزَّ جَارُكَ، وَتَبَارَكَ اِسْمُكَ، وَلَا إِلَهَ غَيْرُكَ","c":3,"r":"البخاري في الأدب المفرد برقم 708 وصحّحه الألباني في صحيح الأدب المفرد برقم 546"}]},{"i":38,"t":"الدُّعَاءُ عَلَى العَدُوِّ","a":[{"t":"اللَّهُمَّ مُنْزِلَ الكِتَابِ، سَرِيعَ الحِسَابِ، اِهْزِمْ الأَحْزَابَ، اللَّهُمَّ اِهْزِمْهُمْ وَزَلْزِلْهُمْ","c":1,"r":"مسلم 3/ 1362"}]},{"i":39,"t":"مَا يَقُولُ مَنْ خَافَ قَوْمًا","a":[{"t":"اللَّهُمَّ اِكْفِنِيهُمْ بِمَا شِئْتَ","c":1,"r":"مسلم 4/ 2300"}]},{"i":40,"t":"دُعَاءُ مَنْ أَصَابَهُ شَكٌّ فِي الِإيمَانِ","a":[{"t":"يَسْتَعِيذُ بِاللَّهِ","c":1,"r":"البخاري مع الفتح 6/ 336 ومسلم 1/ 120"},{"t":"يَنْتَهِي عَمَّا شَكَّ فِيهِ","c":1,"r":"البخاري مع الفتح 6/ 336 ومسلم 1/ 120"},{"t":"يَقُولُ: آمَنْتُ بِاللَّهِ وَرُسُلِهِ","c":1,"r":"مسلم 1/ 119 - 120"},{"t":"يَقْرَأُ قَوْلَهُ تَعَالَى: {هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ}","c":1,"r":"سورة الحديد، الآية: 3. أبو داود 4/ 329 وحسّنه الألبانيّ في صحيح أبي داود 3/ 962"}]},{"i":41,"t":"دُعَاءُ قَضَاءِ الدَّيْنِ","a":[{"t":"اللَّهُمَّ اِكْفِنِي بِحَلَالِكَ عَنْ حَرَامِكَ وَأَغْنِنِي بِفَضْلِكَ عَمَّنْ سِوَاكَ","c":1,"r":"التّرمذي 5/ 560 وانظر صحيح التّرمذي 3/ 180"},{"t":"اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الهَمِّ وَالحَزَنِ، وَالعَجْزِ وَالكَسَلِ، وَالبُخْلِ وَالجُبْنِ، وَضَلَعِ الدَّيْنِ وَغَلَبَةِ الرِّجَالِ","c":1,"r":"البخاري 7/ 158"}]},{"i":42,"t":"دُعَاءُ الوَسْوَسَةِ فِي الصَّلَاةِ وَالقِرَاءَةِ","a":[{"t":"يَقُولُ: (أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ)، وَيَتْفُلْ عَلَى يَسَارِهِ","c":3,"r":"مسلم 4/ 1729 من حديث عثمان بن أبي العاص رضي اللّه عنه، وفيه: ففعلت ذلك فأذهبه اللّه عنّي"}]},{"i":43,"t":"دُعاءُ مَنِ اسْتَصْعَبَ عَلَيْهِ أَمْرٌ","a":[{"t":"اللَّهُمَّ لَا سَهْلَ إِلَّا مَا جَعَلْتَهُ سَهْلًا وَأَنْتَ تَجْعَلُ الحَزْنَ إِذَا شِئْتَ سَهْلًا","c":1,"r":"رواه ابن حبان في صحيحه برقم 2427 (موارد) وابن السّنّي برقم 351 وقال الحافظ: هذا حديث صحيح، وصحّحه عبدالقادر الأرناؤوط في تخريج الأذكار للنّووي ص 106"}]},{"i":44,"t":"مَا يَقُولُ وَيَفْعَلُ مَنْ أَذْنَبَ ذَنْبًا","a":[{"t":"مَا مِنْ عَبْدٍ يُذْنِبُ ذَنْبًا فَيُحْسِنُ الطُّهُورَ، ثُمَّ يَقُومُ فَيُصَلِّي رَكْعَتَيْنِ، ثُمَّ يَسْتَغْفِرُ اللَّهَ إِلَّا غَفَرَ اللَّهُ لَهُ","c":1,"r":"أبو داود 2/ 86 والتّرمذي 2/ 257 وصحّحه الألبانيّ في صحيح أبي داود 1/ 283"}]},{"i":45,"t":"دُعَاءُ طَرْدِ الشَّيْطَانِ وَوَسَاوِسِهِ","a":[{"t":"الاِسْتِعَاذَةُ بِاللَّهِ مِنْهُ","c":1,"r":"أبو داود 1/ 206، والتّرمذي، وانظر صحيح التّرمذي 1/ 77، وانظر سورة المؤمنون آية 98 - 99"},{"t":"الأَذَانُ","c":1,"r":"مسلم 1/ 291 والبخاري 1/ 151"},{"t":"الأَذْكَارُ وَقِرَاءَةُ القُرْآنِ","c":1,"r":"{لاتجعلوا بيوتكم مقابر، إنّ الشّيطان ينفر من البيت الذي تقرأ فيه سورة البقرة} رواه مسلم 1/ 539. ومما يطرد الشّيطان أذكار الصّباح والمساء، والنّوم والاستيقاظ، وغير ذلك من الأذكار المشروعة مثل قراءة آية الكرسيّ عند النّوم، والآيتين الأخيرتين من سورة البقرة، ومن قال: لا إله إلّا اللّه وحده لا شريك له، له الملك وله الحمد وهو على كل شيء قدير مائة مرة كانت له حِرْزًا من الشّيطان يومه كلّه. وكذا الأذان يطرد الشّيطان"}]},{"i":46,"t":"الدُّعَاءُ حِينَمَا يَقَعُ مَا لَا يَرْضَاهُ أَوْ غُلِبَ عَلَى أَمْرِهِ","a":[{"t":"قَدَرُ اللَّهِ. وَمَا شَاءَ فَعَلْ","c":1,"r":"{المؤمن القويّ خير وأحبّ إلى اللّه من المؤمن الضعيف وفي كلّ خير، احرص على ما ينفعك واستعن باللّه ولا تعجز، وإن أصابك شيء فلا تقل لو أنّي فعلت كذا وكذا، ولكن قل: قَدَرُ اللّه. وما شاء فعل، فإنّ لو تفتح عمل الشّيطان} مسلم 4/ 2052"}]},{"i":47,"t":"تَهْنِئَةُ المَوْلُودِ لَهُ وَجَوَابُهُ","a":[{"t":"(بَارَكَ اللَّهُ لَكَ فِي المَوْهُوبِ لَكَ، وَشَكَرْتَ الوَاهِبَ، وَبَلَغَ أَشُدَّهُ، وَرُزِقْتَ بِرَّهُ) وَيَرُدُّ عَلَيْهِ المُهَنَّأُ فَيَقُولُ: (بَارَكَ اللَّهُ لَكَ وَبَارَكَ عَلَيْكَ، وَجَزَاكَ اللَّهُ خَيْرًا، وَرَزَقَكَ اللَّهُ مِثْلَهُ، وَأَجْزَلَ ثَوَابَكَ)","c":1,"r":"انظر الأذكار للنّووي ص 349 وصحيح الأذكار للنّووي لسليم الهلالي 2/ 713"}]},{"i":48,"t":"مَا يُعَوَّذُ بِهِ الأَوْلَادُ","a":[{"t":"كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُعَوِّذُ الحَسَنَ وَالحُسَيْنَ: (أُعِيذُكُمَا بِكَلِمَاتِ اللَّهِ التَّامَّةِ مِنْ كُلِّ شَيْطَانٍ وَهَامَّةٍ، وَمِنْ كُلِّ عَيْنٍ لَامَّةٍ}","c":1,"r":"البخاري 4/ 119 من حديث ابن عبّاس رضي اللّه عنهما"}]},{"i":49,"t":"الدُّعَاءُ لِلْمَرِيضِ فِي عِيَادَتِهِ","a":[{"t":"لَا بَأْسَ، طَهُورٌ إِنْ شَاءَ اللَّهُ","c":1,"r":"البخاري مع الفتح 10/ 118"},{"t":"أَسْأَلُ اللَّهَ العَظِيمَ رَبَّ العَرْشِ العَظِيمِ أَنْ يَشْفِيَكَ","c":7,"r":"ما من عبد مسلم يعود مريضا لم يحضر أجله فيقول سبع مرّات الحيدث إلّا عوفيَ. أخرجه التّرمذي وأبو داود وانظر صحيح التّرمذي 2/ 210 وصحيح الجامع 5/ 180"}]},{"i":50,"t":"فَضْلُ عِيَادَةِ المَرِيضِ","a":[{"t":"قَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (إِذَا عَادَ الرَّجُلُ أَخَاهُ المُسْلِمَ مَشَى فِي خِرَافَةِ الجَنَّةِ حَتَّى يَجْلِسَ فَإِذَا جَلَسَ غَمَرَتْهُ الرَّحْمَةُ، فَإِنْ كَانَ غُدْوَةً صَلَّى عَلَيْهِ سَبْعُونَ أَلْفَ مَلَكٍ حَتَّى يُمْسِي، وَإِنْ كَانَ مَسَاءً صَلَّى عَلَيْهِ سَبْعُونَ أَلْفَ مَلَكٍ حَتَّى يُصْبِحَ)","c":1,"r":"رواه التّرمذي وابن ماجة وأحمد وانظر صحيح ابن ماجة 1/ 244 وصحيح التّرمذي 1/ 286 وصحّحه أيضًا أحمد شاكر"}]},{"i":51,"t":"دُعَاءُ المَرِيضِ الذِي يَئِسَ مِنْ حَيَاتِهِ","a":[{"t":"اللَّهُمَّ اِغْفِرْ لِي وَاِرْحَمْنِي وَأَلْحِقْنِي بِالرَّفِيقِ الأَعْلَى","c":1,"r":"البخاري 7/ 10 ومسلم 4/ 1893"},{"t":"جَعَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عِنْدَ مَوْتِهِ يُدْخِلُ يَدَيْهِ فِي المَاءِ فَيَمْسَحُ بِهِمَا وَجْهَهُ وَيَقُولُ: لَا إِلَهَ إِلَّا اللَّهُ إِنَّ لِلْمَوْتِ لَسَكَرَاتٌ","c":1,"r":"البخاري مع الفتح 8/ 144 وفي الحديث السّواك"},{"t":"لَا إِلَهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ، لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ، لَاإِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَا إِلَهَ إِلَّا اللَّهُ لَهُ المُلْكُ وَلَهُ الحَمْدُ، لَا إِلَهَ إِلَّا اللَّهُ وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ","c":1,"r":"أخرجه التّرمذي وابن ماجة وصحّحه الألبانيّ، انظر صحيح التّرمذي 3/ 152 وصحيح ابن ماجة 2/ 317"}]},{"i":52,"t":"تَلْقِينُ المُحْتَضِرِ","a":[{"t":"مَنْ كَانَ آخِرُ كَلَامِهِ (لَا إِلَهَ إِلَّا اللَّهُ) دَخَلَ الجَنَّةَ","c":1,"r":"أبو داود 3/ 190 وانظر صحيح الجامع 5/ 342"}]},{"i":53,"t":"دُعَاءُ مَنْ أُصِيبَ بِمُصِيبَةٍ","a":[{"t":"إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ، اللَّهُمَّ أْجُرْنِي فِي مُصِيبَتِي وَأَخْلِفْ لِي خَيْرًا مِنْهَا","c":1,"r":"مسلم 2/ 632"}]},{"i":54,"t":"الدُّعَاءُ عِنْدَ إِغْمَاضِ المَيِّتِ","a":[{"t":"اللَّهُمَّ اِغْفِرْ لِفُلَانٍ - بِاِسْمِهِ - وَاِرْفَعْ دَرَجَتَهُ فِي المَهْدِيِّينَ، وَاخْلُفْهُ فِي عَقِبِهِ فِي الغَابِرِينَ، وَاِغْفِرْ لَنَا وَلَهُ يَا رَبَّ العَالَمِينَ، وَاِفْسَحْ لَهُ فِي قَبْرِهِ وَنَوِّرْ لَهُ فِيهِ","c":1,"r":"مسلم 2/ 634"}]},{"i":55,"t":"الدُّعَاءُ لِلْمَيِّتِ فِي الصَّلَاةِ عَلَيْهِ","a":[{"t":"اللَّهُمَّ اِغْفِرْ لَهُ وَاِرْحَمْهُ، وَعَافِهِ، وَاعْفُ عَنْهُ، وَأَكْرِمْ نُزُلَهُ، وَوَسِّعْ مُدْخَلَهُ، وَاغْسِلْهُ بِالمَاءِ وَالثَّلْجِ وَالبَرَدِ، وَنَقِّهِ مِنْ الخَطَايَا كَمَا نَقَّيْتَ الثَّوْبُ الأَبْيَضُ مِنَ الدَّنَسِ، وَأَبْدِلْهُ دَارًا خَيْرًا مِنْ دَارِهِ، وَأَهْلًا خَيْرًا مِنْ أَهْلِهِ، وَزَوْجًا خَيْرًا مِنْ زَوْجِهِ، وَأَدْخِلْهُ الجَنَّةَ، وَأَعِذْهُ مِنْ عَذَابِ القَبْرِ [وَعَذَابِ النَّارِ]","c":1,"r":"مسلم 2/ 663"},{"t":"اللَّهُمَّ اِغْفِرْ لِحَيِّنَا، وَمَيِّتِنَا، وَشَاهِدِنَا، وَغَائِبِنَا، وَصَغِيرِنَا وَكَبِيرِنَا، وَذَكَرِنَا وَأُنْثَانَا. اللَّهُمَّ مَنْ أَحْيَيْتَهُ مِنَّا فَأَحْيِهِ عَلَى الإِسْلَامِ، وَمَنْ تَوَفَّيْتَهُ مِنَّا فَتَوَفَّهُ عَلَى الإِيمَانِ، اللَّهُمَّ لَا تَحْرِمْنَا أَجْرَهُ وَلَا تُضِلَّنَا بَعْدَهُ","c":1,"r":"ابن ماجة 1/ 480 وأحمد 2/ 368 وانظر صحيح ابن ماجة 1/ 251"},{"t":"اللَّهُمَّ إِنَّ فُلَانَ بْنَ فُلَانٍ فِي ذِمَّتِكَ، وَحَبْلِ جِوَارِكَ، فَقِهِ مِنْ فِتْنَةِ القَبْرِ وَعَذَابِ النَّارِ، وَأَنْتَ أَهْلُ الوَفَاءِ وَالحَقِّ، فَاغْفِرْ لَهُ وَاِرْحَمْهُ إِنَّكَ أَنْتَ الغَفُورُ الرَّحِيمُ","c":1,"r":"أخرجه ابن ماجة، انظر صحيح ابن ماجة 1/ 251 ورواه أبو داود 3/ 211"},{"t":"اللَّهُمَّ عَبْدُكَ وَاِبْنُ أَمَتِكَ اِحْتَاجَ إِلَى رَحْمَتِكَ، وَأَنْتَ غَنِيٌّ عَنْ عَذَابِهِ، إِنْ كَانَ مُحْسِنًا فَزِدْ فِي حَسَنَاتِهِ، وَإِنْ كَانَ مُسِيئًا فَتَجَاوَزْ عَنْهُ","c":1,"r":"أخرجه الحاكم وصحّحه ووافقه الذّهبيّ 1/ 359 وانظر أحكام الجنائز للألبانيّ ص 125"}]},{"i":56,"t":"الدُّعَاءُ لِلْفَرَطِ فِي الصَّلَاةِ عَلَيْهِ","a":[{"t":"اللَّهُمَّ أَعِذْهُ مِنْ عَذَابِ القَبْرِ","c":1,"r":"قال سعيد بن المسيّب صلّيت وراء أبي هريرة على صبيّ لم يعمل خطيئة قطّ فسمعته يقول: 'الحديث'. أخرجه مالك في الموطّأ 1/ 288 وابن أبي شيبة في المصنّف 3/ 217 والبيهقي 4/ 9، وصحّح إسناده شعيب الأرناؤوط في تحقيقه لشرح السّنّة للبغوي 5/ 357"},{"t":"وَإِنْ قَالَ: (اللَّهُمَّ اِجْعَلْهُ فَرَطًا وَذُخْرًا لِوَالِدَيْهِ، وَشَفِيعًا مُجَابًا. اللَّهُمَّ ثَقِّلْ بِهِ مَوَازِينَهُمَا وَأَعْظِمْ بِهِ أُجُورَهُمَا وَأَلْحِقْهُ بِصَالِحِ المُؤْمِنِينَ، وَاِجْعَلْهُ فِي كَفَالَةِ إِبْرَاهِيمَ، وَقِهِ بِرَحْمَتِكَ عَذَابَ الجَحِيمِ، وَأَبْدِلْهُ دَارًا خَيْرًا مِنْ دَارِهِ، وَأَهْلًا خَيْرًا مِنْ أَهْلِهِ، اللَّهُمَّ اِغْفِرْ لِأَسْلَافِنَا وَأَفْرَاطِنَا، وَمَنْ سَبَقَنَا بِالإِيمَانِ) فَحَسَنٌ","c":1,"r":"انظر: المغني لابن قدامة 3/ 416 والدّروس المهمّة لعامة الأمة للشيخ عبد العزيز بن عبداللّه بن باز رحمه اللّه ص 15"},{"t":"اللَّهُمَّ اِجْعَلْهُ لَنَا فَرَطًا، وَسَلَفًا، وَأَجْرًا","c":1,"r":"كان الحَسَن يقرأ على الطّفل بفاتحة الكتاب ويقول: 'الحديث'. أخرجه البغوي في شرح السّنّة 5/ 357، وعبد الرزّاق برقم 6588، وعلّقه البخاري في كتاب الجنائز 65 باب قراءة فاتحة الكتاب على الجنازة 2/ 113"}]},{"i":57,"t":"دُعَاءُ التَّعْزِيَةِ","a":[{"t":"إِنَّ لِلَّهِ مَا أَخَذَ، وَلَهُ مَا أَعْطَى، وَكُلُّ شَيْءٍ عِنْدَهُ بِأَجَلٍ مُسَمًّى ... فَلْتَصْبِرْ وَلْتَحْتَسِبْ","c":1,"r":"البخاري 2/ 80 ومسلم 2/ 636"},{"t":"وَإِنْ قَالَ: (أَعْظَمَ اللَّهُ أَجْرَكَ، وَأَحْسَنَ عَزَاءَكَ وَغَفَرَ لِمَيِّتِكَ) فَحَسَنٌ","c":1,"r":"الأذكار للنّووي ص 126"}]},{"i":58,"t":"الدُّعَاءُ عِنْدَ إِدْخَالِ المَيِّتِ القَبْرَ","a":[{"t":"بِسْمِ اللَّهِ وَعَلَى سُنَّةِ رَسُولِ اللَّهِ","c":1,"r":"أبو داود 3/ 314 بسند صحيح وأحمد بلفظ: بسم اللّه وعلى ملّة رسول اللّه. وسنده صحيح"}]},{"i":59,"t":"الدُّعَاءُ بَعْدَ دَفْنِ المَيِّتِ","a":[{"t":"اللَّهُمَّ اِغْفِرْ لَهُ، اللَّهُمَّ ثَبِّتْهُ","c":1,"r":"كان النّبيّ صلّى اللّه عليه وسلّم إذا فرغ من دفن الميّت وقف عليه وقال: (استغفروا لأخيكم وسلوا له التّثبيت، فإنّه الآن يُسأل). أبو داود 3/ 315، والحاكم وصحّحه ووافقه الذّهبيّ 1/ 370"}]},{"i":60,"t":"دُعَاءُ زِيَارَةِ القُبُورِ","a":[{"t":"السَّلَامُ عَلَيْكُمْ أَهْلَ الدِّيَارِ، مِنَ المُؤْمِنِينَ وَالمُسْلِمِينَ، وَإِنَّا إِنْ شَاءَ اللَّهُ بِكُمْ لَاحِقُونَ [وَيَرْحَمُ اللَّهُ المُسْتَقْدِمِينَ مِنَّا وَالمُسْتَأْخِرِينَ] أَسْأَلُ اللَّهَ لَنَا وَلَكُمُ العَافِيَةَ","c":1,"r":"مسلم 2/ 671، وابن ماجة، واللفظ له 1/ 494 عن بريدة رضي اللّه عنه، وما بين المعكوفين من حديث عائشة رضي اللّه عنها عند مسلم 2/ 671"}]},{"i":61,"t":"دُعَاءُ الرِّيحِ","a":[{"t":"اللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَهَا، وَأَعُوذُ بِكَ مِنْ شَرِّهَا","c":1,"r":"أخرجه أبو داود 4/ 326 وابن ماجة 2/ 1228 وانظر صحيح ابن ماجة 2/ 305"},{"t":"اللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَهَا، وَخَيْرَ مَا فِيهَا، وَخَيْرَ مَا أُرْسِلَتْ بِهِ، وَأَعُوذُ بِكَ مِنْ شَرِّهَا، وَشَرِّ مَا فِيهَا، وَشَرِّ مَا أُرْسِلَتْ بِهِ","c":1,"r":"مسلم 2/ 616 والبخاري 4/ 76"}]},{"i":62,"t":"دُعَاءُ الرَّعْدِ","a":[{"t":"سُبْحَانَ الذِي يُسَبِّحُ الرَّعْدُ بِحَمْدِهِ وَالمَلَائِكَةُ مِنْ خِيفَتِهِ","c":1,"r":"كان عبداللّه بن الزّبير رضي اللّه عنهما إذا سَمِعَ الرّعد ترك الحديث وقال: '...'، الموطّأ 2/ 992 وقال الألبانيّ: صحيح الإسناد موقوفا"}]},{"i":63,"t":"مِنْ أَدْعِيَةِ الاسْتِسْقَاءِ","a":[{"t":"اللَّهُمَّ اَسْقِنَا غَيْثًا مُغِيثًا مَرِيئًا مَرِيعًا، نَافِعًا غَيْرَ ضَارٍّ، عَاجِلًا غَيْرَ آجِلٍ","c":1,"r":"أبو داود 1/ 303 وصحّحه الألباني في صحيح أبي داود 1/ 216"},{"t":"اللَّهُمَّ أَغِثْنَا، اللَّهُمَّ أَغِثْنَا، اللَّهُمَّ أَغِثْنَا","c":1,"r":"البخاري 1/ 224 ومسلم 2/ 613"},{"t":"اللَّهُمَّ اسْقِ عِبَادَكَ، وَبَهَائِمَكَ، وَانْشُرْ رَحْمَتَكَ، وَأَحْيِي بَلَدَكَ المَيِّتَ","c":1,"r":"أبو داود 1/ 305 وحسّنه الألباني في صحيح أبي داود 1/ 218"}]},{"i":64,"t":"الدُّعَاءُ إِذَا نَزَلَ المَطَرُ","a":[{"t":"اللَّهُمَّ صَيِّبًا نَافِعًا","c":1,"r":"البخاري مع الفتح 2/ 518"}]},{"i":65,"t":"الذِّكْرُ بَعْدَ نُزُولِ المَطَرِ","a":[{"t":"مُطِرْنَا بِفَضْلِ اللَّهِ وَرَحْمَتِهِ","c":1,"r":"البخاري 1/ 205 ومسلم 1/ 83"}]},{"i":66,"t":"مِنْ أَدْعِيَةِ الاسْتِصْحَاءِ","a":[{"t":"اللَّهُمَّ حَوَالَيْنَا وَلَا عَلَيْنَا، اللَّهُمَّ عَلَى الآكَامِ وَالظِّرَابِ، وَبُطُونِ الأَوْدِيَةِ، وَمَنَابِتِ الشَّجَرِ","c":1,"r":"البخاري 1/ 224 ومسلم 2/ 614"}]},{"i":67,"t":"دُعَاءُ رُؤْيَةِ الهِلَالِ","a":[{"t":"اللَّهُ أَكْبَرُ. اللَّهُمَّ أَهِلَّهُ عَلَيْنَا بِالأَمْنِ وَالإِيمَانِ، وَالسَّلَامَةِ وَالإِسْلَامِ، وَالتَّوْفِيقِ لِمَا تُحِبُّ رَبَّنَا وَتَرْضَى. رَبُّنَا وَرَبُّكَ اللَّهُ","c":1,"r":"التّرمذي 5/ 504 والدّارمي بلفظه 1/ 336 وانظر صحيح التّرمذي 3/ 157"}]},{"i":68,"t":"الدُّعَاءُ عِنْدَ إِفْطَارِ الصَّائِمِ","a":[{"t":"ذَهَبَ الظَّمَأُ وَابْتَلَّتِ العُرُوقُ، وَثَبَتَ الأَجْرُ إِنْ شَاءَ اللَّهُ","c":1,"r":"أخرجه أبو داود 2/ 306 وغيره، وانظر صحيح الجامع 4/ 209"},{"t":"اللَّهُمَّ إِنِّي أَسْأَلُكَ بِرَحْمَتِكَ التِي وَسِعَتْ كُلَّ شَيْءٍ أَنْ تَغْفِرَ لِي","c":1,"r":"أخرجه ابن ماجة 1/ 557 من دعاء عبد اللّه بن عمرو رضي اللّه عنهما، وحسّنه الحافظ في تخريج الأذكار انظر شرح الأذكار 4/ 342"}]},{"i":69,"t":"الدُّعَاءُ قَبْلَ الطَّعَامِ","a":[{"t":"إِذَا أَكَلَ أَحَدُكُمْ طَعَامًا فَلْيَقُلْ: (بِسْمِ اللَّهِ)، فَإِنْ نَسِيَ فِي أَوَّلِهِ فَلْيَقُلْ: (بِسْمِ اللَّهِ فِي أَوَّلِهِ وَآخِرِهِ)","c":1,"r":"أخرجه أبو داود 3/ 347 والتّرمذي 4/ 288 وانظر صحيح التّرمذي 2/ 167"},{"t":"مَنْ أَطْعَمَهُ اللَّهُ الطَّعَامَ فَلْيَقُلْ: (اللَّهُمَّ بَارِكْ لَنَا فِيهِ وَأَطْعِمْنَا خَيْرًا مِنْهُ)، وَمَنْ سَقَاهُ اللَّهُ لَبَنًا فَلْيَقُلْ: (اللَّهُمَّ بَارِكْ لَنَا فِيهِ وَزِدْنَا مِنْهُ)","c":1,"r":"التّرمذي 5/ 506 وانظر صحيح التّرمذي 3/ 158"}]},{"i":70,"t":"الدُّعَاءُ عِنْدَ الفَرَاغِ مِنَ الطَّعَامِ","a":[{"t":"الحَمْدُ لِلَّهِ الذِي أَطْعَمَنِي هَذَا، وَرَزَقَنِيهِ، مِنْ غَيْرِ حَوْلٍ مِنِّي وَلَا قُوَّةٍ","c":1,"r":"أخرجه أصحاب السّنن إلّا النّسائي، وانظر صحيح التّرمذي 3/ 159"},{"t":"الحَمْدُ لِلَّهِ حَمْدًا كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ، غَيْرَ [مَكْفِيٍّ وَلَا] مُوَدَّعٍ، وَلَا مُسْتَغْنًى عَنْهُ رَبَّنَا","c":1,"r":"البخاري 6/ 214 والتّرمذي بلفظه 5/ 507"}]},{"i":71,"t":"دُعَاءُ الضَّيْفِ لِصَاحِبِ الطَّعَامِ","a":[{"t":"اللَّهُمَّ بَارِكْ لَهُمْ فِيمَا رَزَقْتَهُمْ، وَاغْفِرْ لَهُمْ وَارْحَمْهُمْ","c":1,"r":"مسلم 3/ 1615"}]},{"i":72,"t":"الدُّعَاءُ لِمَنْ سَقَاهُ أَوْ إِذَا أَرَادَ ذَلِكَ","a":[{"t":"اللَّهُمَّ أَطْعِمْ مَنْ أَطْعَمَنِي وَاسْقِ مَنْ سَقَانِي","c":1,"r":"مسلم 3/ 126"}]},{"i":73,"t":"الدُّعَاءُ إِذَا أَفْطَرَ عِنْدَ أَهْلِ بَيْتٍ","a":[{"t":"أَفْطَرَ عِنْدَكُمُ الصَّائِمُونَ، وَأَكَلَ طَعَامَكُمُ الأَبْرَارُ، وَصَلَّتْ عَلَيْكُمُ المَلَائِكَةُ","c":1,"r":"سنن أبي داود 3/ 367، وابن ماجة 1/ 556، والنّسائي في عمل اليوم واللّيلة برقم: 296 - 298، ونصّ على أنّه صلّى اللّه عليه وسلّم يقوله إذا أفطر عند أهل بيت، وصحّحه الألباني في صحيح أبي داود 2/ 730"}]},{"i":74,"t":"دُعَاءُ الصَّائِمِ إِذَا حَضَرَ الطَّعَامُ وَلَمْ يُفْطِرْ","a":[{"t":"(إِذَا دُعِيَ أَحَدُكُمْ فَلْيُجِبْ، فَإِنْ كَانَ صَائِمًا فَلْيُصَلِّ وَإِنْ كَانَ مُفْطِرًا فَلْيَطْعَمْ).\r\nوَمَعْنَى فَلْيُصَلِّ أَيْ: فَلْيَدْعُ","c":1,"r":"مسلم 2/ 1054"}]},{"i":75,"t":"مَا يَقُولُ الصَّائِمُ إِذَا سَابَّهُ أَحَدٌ","a":[{"t":"إِنِّي صَائِمٌ، إِنِّي صَائِمٌ","c":1,"r":"البخاري مع الفتح 4/ 103، ومسلم 2/ 806"}]},{"i":76,"t":"الدُّعَاءُ عِنْدَ رُؤْيَةِ بَاكُورَةِ الثَّمَرِ","a":[{"t":"اللَّهُمَّ بَارِكْ لَنَا فِي ثَمَرِنَا، وبَارِكْ لَنَا فِي مَدِينَتِنَا وبَارِكْ لَنَا فِي صَاعِنَا، وبَارِكْ لَنَا فِي مُدِّنَا","c":1,"r":"مسلم 2/ 1000"}]},{"i":77,"t":"دُعَاءُ العُطَاسِ","a":[{"t":"إِذَا عَطَسَ أَحَدُكُمْ فَلْيَقُلْ: (الحَمْدُ لِلَّهِ)، وَلْيَقُلْ لَهُ أَخُوهُ أَوْ صَاحِبُهُ: (يَرْحَمُكَ اللَّهُ)، فَإِذَا قَالَ لَهُ: (يَرْحَمُكَ اللَّهُ)، فَلْيَقُلْ: (يَهْدِيكُمُ اللَّهُ وَيُصْلِحُ بَالَكُمُ)","c":1,"r":"البخاري 7/ 125"}]},{"i":78,"t":"مَا يُقَالُ لِلْكَافِرِ إِذَا عَطَسَ فَحَمِدَ اللَّهَ","a":[{"t":"يَهْدِيكُمْ اللَّهُ وَيُصْلِحُ بَالَكُمْ","c":1,"r":"التّرمذي 5/ 82 وأحمد 4/ 400 وأبو داود 4/ 308، وانظر صحيح التّرمذي 2/ 354"}]},{"i":79,"t":"الدُّعَاءُ لِلْمُتَزَوِّجِ","a":[{"t":"بَارَكَ اللَّهُ لَكَ، وَبَارَكَ عَلَيْكَ، وَجَمَعَ بَيْنَكُمَا فِي خَيْرٍ","c":1,"r":"أخرجه أصحاب السّنن إلّا النّسائي وانظر صحيح التّرمذي 1/ 316"}]},{"i":80,"t":"دُعَاءُ المُتَزَوِّجِ وَشِرَاءِ الدَّابَّةِ","a":[{"t":"إِذَا تَزَوَّجَ أَحَدُكُمْ اِمْرَأَةً، أَوْ إِذَا اِشْتَرَى خَادِمًا فَلْيَقُلْ: (اللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَهَا وَخَيْرَ مَا جَبَلْتَهَا عَلَيْهِ وَأَعُوذُ بِكَ مِنْ شَرِّهَا وَشَرِّ مَا جَبَلْتَهَا عَلَيْهِ) وَإِذَا اِشْتَرَى بَعِيرًا فَلْيَأْخُذْ بِذِرْوَةِ سَنَامِهِ وَلْيَقُلْ مِثْلَ ذَلِكَ","c":1,"r":"أبو داود 2/ 248 وابن ماجة 1/ 617 وانظر صحيح ابن ماجة 1/ 324"}]},{"i":81,"t":"الدُّعَاءُ قَبْلَ إِتُيَانِ الزَّوْجَةِ","a":[{"t":"بِسْمِ اللَّهِ، اللَّهُمَّ جَنِّبْنَا الشَّيْطَانَ وَجَنِّبْ الشَّيْطَانَ مَا رَزَقْتَنَا","c":1,"r":"البخاري 6/ 141 ومسلم 2/ 1028"}]},{"i":82,"t":"دُعَاءُ الغَضَبِ","a":[{"t":"أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ","c":1,"r":"البخاري 7/ 99 ومسلم 4/ 2015"}]},{"i":83,"t":"دُعَاءُ مَنْ رَأَى مُبْتَلًى","a":[{"t":"الحَمْدُ لِلَّهِ الذِي عَافَانِي مِمَّا اِبْتَلَاكَ بِهِ وَفَضَّلَنِي عَلَى كَثِيرٍ مِمَّنْ خَلَقَ تَفْضِيلًا","c":1,"r":"التّرمذي 5/ 493 و 494 وانظر صحيح التّرمذي 3/ 153"}]},{"i":84,"t":"مَا يُقَالُ فِي المَجْلِسِ","a":[{"t":"عَنِ اِبْنِ عُمَرَ قَالَ: كَانَ يُعَدُّ لِرَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي المَجْلِسِ الوَاحِدِ مِائَةُ مَرَّةٍ مِنْ قَبْلِ أَنْ يَقُومَ: (رَبِّ اِغْفِرْ لِي وَتُبْ عَلَيَّ إِنَّكَ أَنْتَ التَّوَّابُ الغَفُورُ)","c":100,"r":"التّرمذي وغيره وانظر صحيح التّرمذي 3/ 153 وصحيح ابن ماجة 2/ 321 ولفظه للتّرمذي"}]},{"i":85,"t":"كَفَّارَةُ المَجْلِسِ","a":[{"t":"سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ، أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ","c":1,"r":"أخرجه أصحاب السّنن وانظر صحيح التّرمذي 3/ 153، وقد ثبت أنّ عائشة رضي اللّه عنها قالت: ما جلس رسول اللّه صلّى اللّه عليه وسلّم مجلسا، ولا تلى قرآنا، ولا صلّى صلاة إلّا ختم ذلك بكلمات: '...'، أخرجه النّسائي في عمل اليوم واللّيلة برقم 308، وأحمد 6/ 77 وصحّحه الدّكتور فاروق حمادة في تحقيقه لعمل اليوم واللّيلة للنّسائي ص 273"}]},{"i":86,"t":"الدُّعَاءُ لِمَنْ قَالَ غَفَرَ اللَّهُ لَكَ","a":
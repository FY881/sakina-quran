[{"t":"وَلَكَ","c":1,"r":"أحمد 5/ 82 والنّسائي في عمل اليوم واللّيلة ص 218 برقم 421 تحقيق الدّكتور فاروق حمادة"}]},{"i":87,"t":"الدُّعَاءُ لِمَنْ صَنَعَ إِلَيْكَ مَعْرُوفًا","a":[{"t":"جَزَاكَ اللَّهُ خَيْرًا","c":1,"r":"أخرجه التّرمذي رقم 2035 وانظر صحيح الجامع 6244 وصحيح التّرمذي 2/ 200"}]},{"i":88,"t":"مَا يَعْصِمُ اللَّهُ بِهِ مِنَ الدَّجَّالِ","a":[{"t":"مَنْ حَفِظَ عَشْرَ آيَاتٍ مِنْ أَوَّلِ سُورَةِ الكَهْفِ عُصِمَ مِنَ الدَّجَّالِ","c":1,"r":"مسلم 1/ 555، وفي رواية من آخر الكهف 1/ 556"},{"t":"وَالاِسْتِعَاذَةُ بِاللَّهِ مِنْ فِتْنَتِهِ عَقِبَ التَّشَهُّدِ الأَخِيرِ مِنْ كُلِّ صَلَاةٍ","c":1,"r":"انظر حديث رقم 55 وحديث رقم 56 من هذا الكتاب"}]},{"i":89,"t":"الدُّعَاءُ لِمَنْ قَالَ إِنِّي أُحِبُّكَ فِي اللَّهِ","a":[{"t":"أَحَبَّكَ الذِي أَحْبَبْتَنِي لَهُ","c":1,"r":"أخرجه أبو داود 4/ 333، وحسّنه الألباني في صحيح سنن أبي داود 3/ 965"}]},{"i":90,"t":"الدُّعَاءُ لِمَنْ عَرَضَ عَلَيْكَ مَالَهُ","a":[{"t":"بَارَكَ اللَّهُ لَكَ فِي أَهْلِكَ وَمَالِكَ","c":1,"r":"البخاري مع الفتح 4/ 88"}]},{"i":91,"t":"الدُّعَاءُ لِمَنْ أَقْرَضَ عِنْدَ القَضَاءِ","a":[{"t":"بَارَكَ اللَّهُ لَكَ فِي أَهْلِكَ وَمَالِكَ، إِنَّمَا جَزَاءُ السَّلَفِ الحَمْدُ وَالأَدَاءُ","c":1,"r":"أخرجه النّسائي في عمل اليوم واللّيلة ص 300 وابن ماجة 2/ 809 وانظر صحيح ابن ماجة 2/ 55"}]},{"i":92,"t":"دُعَاءُ الخَوْفِ مِنَ الشِّرْكِ","a":[{"t":"اللَّهُمَّ إِنِّي أَعُوذُ بِكَ أَنْ أُشْرِكَ بِكَ وَأَنَا أَعْلَمُ، وَأَسْتَغْفِرُكَ لِمَا لَا أَعْلَمُ","c":1,"r":"أحمد 4/ 403 وغيره وانظر صحيح الجامع 3/ 233 وصحيح التّرغيب والتّرهيب للألباني 1/ 19"}]},{"i":93,"t":"الدُّعَاءُ لِمَنْ قَالَ بَارَكَ اللَّهُ فِيكَ","a":[{"t":"وَفِيكَ بَارَكَ اللَّهُ","c":1,"r":"أخرجه ابن السّني ص 138 برقم 278 وانظر الوابل الصّيب لابن القيّم ص 304 تحقيق بشير محمد عيون"}]},{"i":94,"t":"دُعَاءُ كَرَاهِيَّةِ الطِّيرَةِ","a":[{"t":"اللَّهُمَّ لَا طَيْرَ إِلَّا طَيْرُكَ، وَلَا خَيْرَ إِلَّا خَيْرُكَ، وَلَا إِلَهَ غَيْرُكَ","c":1,"r":"أحمد 2/ 220، وابن السني برقم 292، وصححه الألباني في الأحاديث الصحيحة 3/ 54، رقم 1065، أما الفأل فكان يعجب النّبيّ صلّى اللّه عليه وسلّم ولهذا سمع من رجل كلمة طيّبة فأعجبته فقال: (أخذنا فألك من فيك) أبو داود وأحمد، وصححه الألباني في الصحيحة 2/ 363 عند أبي الشيخ في أخلاق النّبيّ صلّى اللّه عليه وسلّم ص 270"}]},{"i":95,"t":"دُعَاءُ الرُّكُوبِ","a":[{"t":"بِسْمِ اللَّهِ، وَالحَمْدُ لِلَّهِ، {سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ * وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ} الحَمْدُ لِلَّهِ، الحَمْدُ لِلَّهِ، الحَمْدُ لِلَّهِ، اللَّهُ أَكْبَرُ، اللَّهُ أَكْبَرُ، اللَّهُ أَكْبَرُ، سُبْحَانَكَ اللَّهُمَّ إِنِّي ظَلَمْتُ نَفْسِي فَاِغْفِرْ لِي، فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ","c":1,"r":"أبو داود 3/ 34 والتّرمذي 5/ 501 وانظر صحيح التّرمذي 3/ 156"}]},{"i":96,"t":"دُعَاءُ السَّفَرِ","a":[{"t":"اللَّهُ أَكْبَرُ، اللَّهُ أَكْبَرُ، اللَّهُ أَكْبَرُ، {سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ * وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ} اللَّهُمَّ إِنَّا نَسْأَلُكَ فِي سَفَرِنَا هَذَا البِرَّ وَالتَّقْوَى، وَمِنَ العَمَلِ مَا تَرْضَى، اللَّهُمَّ هَوِّنْ عَلَيْنَا سَفَرَنَا هَذَا وَاطْوِ عَنَّا بُعْدَهُ، اللَّهُمَّ أَنْتَ الصَّاحِبُ فِي السَّفَرِ، وَالخَلِيفَةُ فِي الأَهْلِ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ وَعْثَاءِ السَّفَرِ، وَكَآبَةِ المَنْظَرِ، وَسُوءِ المُنْقَلَبِ فِي المَالِ وَالأَهْلِ. وَإِذَا رَجَعَ قَالَهُنَّ وَزَادَ فِيهِنَّ: (آيِبُونَ، تَائِبُونَ، عَابِدُونَ، لِرَبِّنَا حَامِدُونَ)","c":1,"r":"مسلم 2/ 998"}]},{"i":97,"t":"دُعَاءُ دُخُولِ القَرْيَةِ أَو البَلْدَةِ","a":[{"t":"اللَّهُمَّ رَبَّ السَّمَوَاتِ السَّبْعِ وَمَا أَظْلَلْنَ، وَرَبَّ الأَرَضِينِ السَّبْعِ وَمَا أَقْلَلْنَ، وَرَبَّ الشَّيَاطِينِ وَمَا أَضْلَلْنَ، وَرَبَّ الرِّيَاحِ وَمَا ذَرَيْنَ، أَسْأَلُكَ خَيْرَ هَذِهِ القَرْيَةِ وَخَيْرَ أَهْلِهَا، وَخَيْرَ مَا فِيهَا، وَأَعُوذُ بِكَ مِنْ شَرِّهَا، وَشَرِّ أَهْلِهَا، وَشَرِّ مَا فِيهَا","c":1,"r":"الحاكم وصحّحه ووافقه الذّهبي 2/ 100 وابن السّني برقم 524 وحسّنه الحافظ في تخريج الأذكار 5/ 154، قال ابن باز: ورواه النّسائي بإسناد حسن. انظر تحفة الأخيار ص 37"}]},{"i":98,"t":"دُعَاءُ دُخُولِ السُّوقِ","a":[{"t":"لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ المُلْكُ وَلَهُ الحَمْدُ، يُحْيِي وَيُمِيتُ وَهُوَ حَيٌّ لَا يَمُوتُ، بِيَدِهِ الخَيْرُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","c":1,"r":"التّرمذي 5/ 491 والحاكم 1/ 538 وحسّنه الألباني في صحيح ابن ماجة 2/ 21 وفي صحيح التّرمذي 3/ 152"}]},{"i":99,"t":"الدُّعَاءُ إِذَا تَعِسَ المَرْكُوبُ","a":[{"t":"بِسْمِ اللَّهِ","c":1,"r":"أبو داود 4/ 296 وصحّحه الألباني في صحيح أبي داود 3/ 941"}]},{"i":100,"t":"دُعَاءُ المُسَافِرِ لِلْمُقِيمِ","a":[{"t":"أَسْتَوْدِعُكُمُ اللَّهَ الذِي لَا تَضِيعُ وَدَائِعُهُ","c":1,"r":"أحمد 2/ 403 وابن ماجة 2/ 943 وانظر صحيح ابن ماجة 2/ 133"}]},{"i":101,"t":"دُعَاءُ المُقِيمِ لِلْمُسَافِرِ","a":[{"t":"أَسْتَوْدِعُ اللَّهَ دِينَكَ، وَأَمَانَتَكَ، وَخَوَاتِيمَ عَمَلِكَ","c":1,"r":"أحمد 2/ 7 والتّرمذي 5/ 499 وانظر صحيح التّرمذي 2/ 155"},{"t":"زَوَّدَكَ اللَّهُ التَّقْوَى، وَغَفَرَ ذَنْبَكَ، وَيَسَّرَ لَكَ الخَيْرَ حَيْثُ مَا كُنْتَ","c":1,"r":"التّرمذي وانظر صحيح التّرمذي 3/ 155"}]},{"i":102,"t":"التَّكْبِيرُ وَالتَّسْبِيحُ فِي سَيْرِ السَّفَرِ","a":[{"t":"قَالَ جَابِرٌ رَضِيَ اللَّهُ عَنْهُ: (كُنَّا إِذَا صَعَدْنَا كَبَّرْنَا، وَإِذَا نَزَلْنَا سَبَّحْنَا)","c":1,"r":"البخاري مع الفتح 6/ 135"}]},{"i":103,"t":"دُعَاءُ المُسَافِرِ إِذَا أَسْحَرَ","a":[{"t":"سَمَّـِعَ سَامِعٌ بِحَمْدِ اللَّهِ، وَحُسْنِ بَلَائِهِ عَلَيْنَا. رَبَّنَا صَاحِبْنَا، وَأَفْضِلْ عَلَيْنَا عَائِذًا بِاللَّهِ مِنَ النَّارِ","c":1,"r":"مسلم 4/ 2086 ومعنى سمِع سامع: أي شهد شاهد على حمدنا للّه تعالى على نعمه وحسن بلائه. ومعنى سمَّع سامع: بلّغ سامع قولي هذا لغيره وقال مثله تنبيها على الذِّكر في السّحر والدعاء. وقوله: ربّنا صاحبنا وأفضل علينا: أي احفظنا وحطنا واكلأنا وأفضل علينا بجزيل نعمك واصرف عنّا كلّ مكروه، شرح النّووي 17/ 39"}]},{"i":104,"t":"الدُّعَاءُ إِذَا نَزَلَ مَنْزِلًا فِي سَفَرٍ أَوْ غَيْرِهِ","a":[{"t":"أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَاتِ مِنْ شَرِّ مَا خَلَقَ","c":1,"r":"مسلم 4/ 2080"}]},{"i":105,"t":"ذِكْرُ الرُّجُوعِ مِنَ السَّفَرِ","a":[{"t":"يُكِبِّرُ عَلَى كُلِّ شَرَفٍ ثَلَاثَ تَكْبِيرَاتٍ ثُمَّ يَقُولُ: لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ المُلْكُ، وَلَهُ الحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، آيِبُونَ، تَائِبُونَ، عَابِدُونَ، لِرَبِّنَا حَامِدُونَ، صَدَقَ اللَّهُ وَعْدَهُ، وَنَصَرَ عَبْدَهُ، وَهَزَمَ الأَحْزَابَ وَحْدَهُ","c":1,"r":"كان النّبيّ صلّى اللّه عليه وسلّم يقوله إذا قفل من غزو أو حجّ، البخاري 7/ 163 ومسلم 2/ 980"}]},{"i":106,"t":"مَا يَقُولُ مَنْ أَتَاهُ أَمْرٌ يَسُرُّهُ أَوْ يَكْرَهُهُ","a":[{"t":"كَانَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَتَاهُ الأَمْرُ يَسُرُّهُ قَالَ: (الحَمْدُ لِلَّهِ الذِي بِنِعْمَتِهِ تَتِمُّ الصَّالِحَاتُ) وَإِذَا أَتَاهُ الأَمْرُ يَكْرَهُهُ قَالَ: (الحَمْدُ لِلَّهِ عَلَى كُلِّ حَالٍ)","c":1,"r":"أخرجه ابن السّني في عمل اليوم واللّيلة، والحاكم وصحّحه 1/ 499 وصحّحه الألباني رحمه اللّه في صحيح الجامع 4/ 201"}]},{"i":107,"t":"فَضْلُ الصَّلَاةِ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ","a":[{"t":"قَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (مَنْ صَلَّى عَلَيَّ صَلَاةً صَلَّى اللَّهُ عَلَيْهِ بِهَا عَشْرًا)","c":1,"r":"أخرجه مسلم 1/ 288"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (لَا تَجْعَلُوا قَبْرِي عِيدًا وَصَلُّوا عَلَيَّ، فَإِنَّ صَلَاتَكُمْ تَبْلُغُنِي حَيْثُ كُنْتُمْ)","c":1,"r":"أبو داود 2/ 218 وأحمد 2/ 367 وصحّحه الألباني في صحيح أبي داود 2/ 383"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (البَخِيلُ مَنْ ذُكِرْتُ عِنْدَهُ فَلَمْ يُصَلِّ عَلَيَّ)","c":1,"r":"التّرمذي 5/ 551 وغيره، وانظر صحيح الجامع 3/ 25 وصحيح التّرمذي 3/ 177"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (إِنَّ لِلَّهِ مَلَائِكَةً سَيَّاحِينَ فِي الأَرْضِ يُبَلِّغُونِي مِنْ أُمَّتِيَ السَّلاَمَ)","c":1,"r":"النّسائي، والحاكم 2/ 421، وصحّحه الألباني في صحيح النّسائي 1/ 274"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (مَا مِنْ أَحَدٍ يُسَلِّمُ عَلَيَّ إِلَّا رَدَّ اللَّهُ عَلَيَّ رُوحِيَ حَتَّى أَرُدَّ عَلَيْهِ السَّلَامَ)","c":1,"r":"أبو داود برقم 2041 وحسّنه الألباني في صحيح أبي داود 1/ 383"}]},{"i":108,"t":"إِفْشَاءُ السَّلَامِ","a":[{"t":"قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (لَاتَدْخُلُوا الجَنَّةَ حَتَّى تُؤْمِنُوا، وَلَا تُؤْمِنُوا حَتَّى تَحَابُّوا، أَوَلَا أَدُلُّكُمُ عَلَى شَيْءٍ إِذَا فَعَلْتُمُوهُ تَحَابَبَتُمْ؟ أَفْشُوا السَّلَامَ بَيْنَكُمْ)","c":1,"r":"مسلم 1/ 74 وغيره"},{"t":"ثَلَاثٌ مَنْ جَمَعَهُنَّ فَقَدْ جَمَعَ الإِيمَانَ: (الإِنْصَافُ مِنْ نَفْسِكَ، وَبَذْلُ السَّلَامِ لِلْعَالَمِ، وَالإِنْفَاقُ مِنَ الإِقْتَارِ)","c":1,"r":"البخاري مع الفتح 1/ 82 عن عمّار رضي اللّه عنه موقوفا معلّقا"},{"t":"وَعَنْ عَبْدِاللَّهِ بْنِ عُمَرَ رَضِيَ اللَّهُ عَنْهُمَا: أَنَّ رَجُلًا سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: أَيُّ الإِسْلَامِ خَيْرٌ؟ قَالَ: (تُطْعِمُ الطَّعَامَ، وَتَقْرَأُ السَّلَامَ عَلَى مَنْ عَرَفْتَ وَمَنْ لَمْ تَعْرِفْ)","c":1,"r":"البخاري مع الفتح 1/ 55 ومسلم 1/ 65"}]},{"i":109,"t":"كَيْفَ يَرُدُّ السَّلَامُ عَلَى الكَافِرِ إِذَا سَلَّمَ","a":[{"t":"إِذَا سَلَّمَ عَلَيْكُمْ أَهْلُ الكِتَابِ فَقُولُوا: (وَعَلَيْكُمْ)","c":1,"r":"البخاري مع الفتح 11/ 42، ومسلم 4/ 1705"}]},{"i":110,"t":"الدُّعَاءُ عِنْدَ صِيَاحِ الدِّيكِ وَنَهِيقِ الحِمَارِ","a":[{"t":"إِذَا سَمِعْتُمْ صِيَاحَ الدِّيَكَةِ فَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ، فَإِنَّهَا رَأَتْ مَلَكًا. وَإِذَا سَمِعْتُمْ نَهِيقَ الحِمَارَ فَتَعَوَّذُوا بِاللَّهِ مِنَ الشَّيْطَانِ، فَإِنَّهُ رَأَى شَيْطَانًا","c":1,"r":"البخاري مع الفتح 6/ 350 ومسلم 4/ 2092"}]},{"i":111,"t":"الدُّعَاءُ عِنْدَ سَمَاعِ نُبَاحِ الكِلَابِ بِاللَّيْلِ","a":[{"t":"إِذَا سَمِعْتُمْ نُبَاحَ الكِلَابِ وَنَهِيقَ الحَمِيرِ بِاللَّيْلِ فَتَعَوَّذُوا بِاللَّهِ مِنْهُمْ، فَإِنَّهُنَّ يَرَيْنَ مَا لَا تَرَوْنَ","c":1,"r":"أبو داود 4/ 327 وأحمد 3/ 306 وصحّحه الألباني في صحيح أبي داود 3/ 961"}]},{"i":112,"t":"الدُّعَاءُ لِمَنْ سَبَبْتَهُ","a":[{"t":"قَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (اللَّهُمَّ فَأَيُّمَا مُؤْمِنٍ سَبَبْتُهُ فَاجْعَلْ ذَلِكَ لَهُ قُرْبَةً إِلَيْكَ يَوْمَ القِيَامَةِ)","c":1,"r":"البخاري مع الفتح 11/ 171 ومسلم 4/ 2007 ولفظه: فاجعلها له زكاة ورحمة"}]},{"i":113,"t":"مَا يَقُولُ المُسْلِمُ إِذَا مَدَحَ المُسْلِمَ","a":[{"t":"قَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (إِذَا كَانَ أَحَدُكُمُ مَادِحًا صَاحِبَهُ لَا مَحَالَةَ، فَلْيَقُلْ: أَحْسَبُ فُلَانًا وَاللَّهُ حَسِيبُهُ، وَلَا أُزَكِّي عَلَى اللَّهِ أَحَدًا، أَحْسِبُهُ - إِنْ كَانَ يَعْلَمُ ذَاكَ - كَذَا وَكَذَا)","c":1,"r":"رواه مسلم 4/ 2296"}]},{"i":114,"t":"مَا يَقُولُ المُسْلِمُ إِذَا زُكِّيَ","a":[{"t":"اللَّهُمَّ لَا تُؤَاخِذْنِي بِمَا يَقُولُونَ، وَاِغْفِرْ لِي مَا لَا يَعْلَمُونَ [وَاِجْعَلْنِي خَيْرًا مِمَّا يَظُنُّونَ]","c":1,"r":"البخاري في الأدب المفرد برقم 761، وصحّح إسناده الألباني في صحيح الأدب المفرد برقم 585، وما بين المعكوفين زيادة للبيهقي في شعب الإيمان 4/ 228 من طريق آخر."}]},{"i":115,"t":"كَيْفَ يُلَبِّي المُحْرِمُ فِي الحَجِّ أَوْ العُمْرَةِ","a":[{"t":"لَبَّيْكَ اللَّهُمَّ لَبَّيْكَ، لَبَّيْكَ لَا شَرِيكَ لَكَ لَبَّيْكَ، إِنَّ الحَمْدَ، وَالنِّعْمَةَ، لَكَ وَالمُلْكُ، لَا شَرِيكَ لَكَ","c":1,"r":"البخاري مع الفتح 3/ 408، ومسلم 2/ 841"}]},{"i":116,"t":"التَّكْبِيرُ إِذَا أَتَى الرُّكْنَ الأَسْوَدَ","a":[{"t":"طَافَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالبَيْتِ عَلَى بَعِيرٍ كُلَّمَا أَتَى الرُّكْنَ أَشَارَ إِلَيْهِ بِشَيْءٍ عِنْدَهُ وَكَبَّرَ","c":1,"r":"البخاري مع الفتح 3/ 476 والمراد بالشيء: المحجن. انظر: البخاري مع الفتح 3/ 472"}]},{"i":117,"t":"الدُّعَاءُ بَيْنَ الرُّكْنِ اليَمَانِي وَالحَجَرِ الأَسْوَدِ","a":[{"t":"{رَبَّنَا ءَاتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ}","c":1,"r":"أبو داود 2/ 179، وأحمد 3/ 411 والبغوي في شرح السّنّة 7/ 128، وحسّنه الألباني في صحيح أبي داود 1/ 354، والآية من سورة البقرة: 201"}]},{"i":118,"t":"دُعَاءُ الوُقُوفِ عَلَى الصَّفَا وَالمَرْوَةِ","a":[{"t":"لَمَّا دَنَا صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ الصَّفَا قَرَأَ {إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَآئِرِ اللَّهِ} (أَبْدَأُ بِمَا بَدَأَ اللَّهُ بِهِ) فَبَدَأَ بِالصَّفَا فَرَقِيَ عَلَيْهِ حَتَّى رَأَى البَيْتَ فَاسْتَقْبَلَ القِبْلَةَ فَوَحَّدَ اللَّهَ وَكَبَّرَهُ وَقَالَ: (لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ المُلْكُ وَلَهُ الحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ، أَنْجَزَ وَعْدَهُ، وَنَصَرَ عَبْدَهُ، وَهَزَمَ الأَحْزَابَ وَحْدَهُ)، ثُمَّ دَعَا بَيْنَ ذَلِكَ. قَالَ مِثْلَ هَذَا ثَلَاثَ مَرَّاتٍ (الحَدِيثْ). وَفِيهِ: (فَفَعَلَ عَلَى المَرْوَةِ كَمَا فَعَلَ عَلَى الصَّفَا)","c":1,"r":"مسلم 2/ 888، والآية من سورة البقرة: 158"}]},{"i":119,"t":"الدُّعَاءُ يَوْمَ عَرَفَةَ","a":[{"t":"خَيْرُ الدُّعَاءِ دُعَاءُ يَوْمِ عَرَفَةَ، وَخَيْرُ مَا قُلْتُ أَنَا وَالنَّبِيُّونَ مِنْ قَبْلِي: لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ المُلْكُ وَلَهُ الحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","c":1,"r":"التّرمذي وحسّنه الألباني في صحيح التّرمذي 3/ 184، وفي الأحاديث الصّحيحة 4/ 6"}]},{"i":120,"t":"الذِّكْرُ عِنْدَ المَشْعَرِ الحَرَامِ","a":[{"t":"رَكِبَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ القَصْوَاءَ حَتَّى أَتَى المَشْعَرَ الحَرَامَ، فَاسْتَقْبَلَ القِبْلَةَ (فَدَعَاهُ، وَكَبَّرَهُ، وَهَلَّلَهُ، وَوَحَّدَهُ) فَلَمْ يَزَلْ وَاقِفًا حَتَّى أَسْفَرَ جِدًّا، فَدَفَعَ قَبْلَ أَنْ تَطْلُعَ الشَّمْسُ","c":1,"r":"مسلم 2/ 891"}]},{"i":121,"t":"التَّكْبِيرُ عِنْدَ رَمْيِ الجِمَارِ مَعَ كُلِّ حَصَاةٍ","a":[{"t":"يُكَبِّرُ كُلَّمَا رَمَى بِحَصَاةٍ عِنْدَ الجِمَارِ الثَّلَاثِ، ثُمَّ يَتَقَدَّمُ، وَيَقِفُ يَدْعُو مُسْتَقْبِلَ القِبْلَةِ، رَافِعًا يَدَيْهِ بَعْدَ الجَمْرَةِ الأُولَى وَالثَّانِيَةِ. أَمَّا جَمْرَةُ العَقَبَةِ فَيَرْمِيهَا وَيُكَبِّرُ عِنْدَ كُلِّ حَصَاةٍ وَيَنْصَرِفُ وَلَا يَقِفُ عِنْدَهَا","c":1,"r":"البخاري مع الفتح 3/ 583 و 3/ 584، وانظر لفظه هناك. والبخاري مع الفتح 3/ 581 ورواه مسلم أيضا."}]},{"i":122,"t":"دُعَاءُ التَّعَجُّبِ وَالأَمْرِ السَّارِ","a":[{"t":"سُبْحَانَ اللَّهِ","c":1,"r":"البخاري مع الفتح 1/ 210 و 390 و 414 ومسلم 4/ 1857"},{"t":"اللَّهُ أَكْبَرُ","c":1,"r":"البخاري مع الفتح 8/ 441 وانظر صحيح التّرمذي 2/ 103 و 2/ 235 ومسند أحمد 5/ 218"}]},{"i":123,"t":"مَا يَفْعَلُ مَنْ أَتَاهُ أَمْرٌ يَسُرُّهُ","a":[{"t":"كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ إِذَا أَتَاهُ أَمْرٌ يَسُرُّهُ أَوْ يُسَرُّ بِهِ خَرَّ سَاجِدًا شُكْرًا لِلَّهِ تَبَارَكَ وَتَعَالَى","c":1,"r":"رواه أهل السّنن إلّا النّسائي. انظر صحيح ابن ماجة 1/ 233 وإرواء الغليل 2/ 226"}]},{"i":124,"t":"مَا يَقُولُ مَنْ أَحَسَّ وَجَعًا فِي جَسَدِهِ","a":[{"t":"ضَعْ يَدَكَ عَلَى الذِي تَأَلَّمَ مِنْ جَسَدِكَ وَقُلْ: (بِسْمِ اللَّهِ) ثَلَاثًا. وَقُلْ سَبْعَ مَرَّاتٍ: (أَعُوذُ بِاللَّهِ وَقُدْرَتِهِ مِنْ شَرِّ مَا أَجِدُ وَأُحَاذِرُ)","c":1,"r":"مسلم 4/ 1728"}]},{"i":125,"t":"دُعَاءُ مَنْ خَشِيَ أَنْ يُصِيبَ شَيْئًا بِعَيْنِهِ","a":[{"t":"إِذَا رَأَى أَحَدُكُمْ مِنْ أَخِيهِ، أَوْ مِنْ نَفْسِهِ، أَوْ مِنْ مَالِهِ مَا يُعْجِبُهُ [فَلْيَدْعُ لَهُ بِالبَرَكَةِ] فَإِنَّ العَيْنَ حَقٌّ","c":1,"r":"مسند أحمد 4/ 447 وابن ماجة، ومالك، وصحّحه الألباني في صحيح الجامع 1/ 212 وانظر تحقيق زاد المعاد للأرناؤوط 4/ 170"}]},{"i":126,"t":"مَا يُقَالُ عِنْدَ الفَزَعِ","a":[{"t":"لَا إِلَهَ إِلَّا اللَّهُ","c":1,"r":"البخاري مع الفتح 6/ 181، ومسلم 4/ 2208"}]},{"i":127,"t":"مَا يَقُولُ عِنْدَ الذَّبْحِ أَوْ النَّحْرِ","a":[{"t":"بِسْمِ اللَّهِ وَاللَّهُ أَكْبَرُ، [اللَّهُمَّ مِنْكَ وَلَكَ]، اللَّهُمَّ تَقَبَّلْ مِنِّي","c":1,"r":"مسلم 3/ 1557، والبيهقي 9/ 287/ ومابين المعكوفين للبيهقي 9/ 287، وغيره والجملة الأخيرة سقتها بالمعنى من رواية مسلم"}]},{"i":128,"t":"مَا يَقُولُ لِرَدِّ كَيْدِ مَرَدَةِ الشَّيَاطِينِ","a":[{"t":"أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ التِي لَا يُجَاوِزُهُنَّ بَرٌّ وَلَا فَاجِرٌ مِنْ شَرِّ مَا خَلَقَ، وَبَرَأَ وَذَرَأَ، وَمِنْ شَرِّ مَا يَنْزِلُ مِنَ السَّمَاءِ، وَمِنْ شَرِّ مَا يَعْرُجُ فِيهَا، وَمِنْ شَرِّ مَا ذَرَأَ فِي الأَرْضِ، وَمِنْ شَرِّ مَا يَخْرُجُ مِنْهَا، وَمِنْ شَرِّ فِتَنِ اللَّيْلِ وَالنَّهَارِ، وَمِنْ شَرِّ كُلِّ طَارِقٍ إِلَّا طَارِقًا يَطْرُقُ بِخَيْرً يَا رَحْمَانُ","c":1,"r":"أحمد 3/ 419 بإسناد صحيح وابن السّني برقم 637 وصحّح إسناده الأرناؤوط في تخريجه للطّحاوية ص 133 وانظر مجمع الزوائد 10/ 127"}]},{"i":129,"t":"الاسْتِغْفَارُ وَالتَّوْبَةُ","a":[{"t":"قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (وَاللَّهِ إِنِّي لَأَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ فِي اليَوْمِ أَكْثَرَ مِنْ سَبْعِينَ مَرَّةٍ)","c":1,"r":"البخاري مع الفتح 11/ 101"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (يَا أَيُّهَا النَّاسُ تُوبُوا إِلَى اللَّهِ فَإِنِّي أَتُوبُ فِي اليَوْمِ إِلَيْهِ مِائَةَ مَرَّةٍ)","c":1,"r":"مسلم 4/ 2076"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (مَنْ قَالَ أَسْتَغْفِرُ اللَّهَ العَظِيمَ الذِي لَا إِلَهَ إِلَّا هُوَ الحَيُّ القَيُّومُ وَأَتُوبُ إِلَيْهِ، غَفَرَ اللَّهُ لَهُ وَإِنْ كَانَ فَرَّ مِنَ الزَّحْفِ)","c":1,"r":"أخرجه أبو داود 2/ 85 والتّرمذي 5/ 569 والحاكم وصحّحه ووافقه الذّهبي 1/ 511 وصحّحه الألباني. انظر صحيح الترمذي 3/ 182 وجامع الأصول لأحاديث الرسول صلّى اللّه عليه وسلّم 4/ 389 - 390 بتحقيق الأرناؤوط"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (أَقْرَبُ مَا يَكُونُ الرَّبُّ مِنَ العَبْدِ فِي جَوْفِ اللَّيْلِ الآخِرِ، فَإِنْ اِسْتَطَعْتَ أَنْ تَكُونَ مِمَّنْ يَذْكُرُ اللَّهَ فِي تِلْكَ السَّاعَةِ فَكُنْ)","c":1,"r":"أخرجه الترمذي والنسائي 1/ 279، والحاكم وانظر صحيح الترمذي 3/ 183 وجامع الأصول بتحقيق الأرناؤوط 4/ 144"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (أَقْرَبُ مَا يَكُونُ العَبْدُ مِنْ رَبِّهِ وَهُوَ سَاجِدٌ فَأَكْثِرُوا الدُّعَاءَ)","c":1,"r":"مسلم 1/ 350"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (إِنَّهُ لَيُغَانُ عَلَى قَلْبِي وَإِنِّي لَأَسْتَغْفِرُ اللَّهَ فِي اليَوْمِ مِائَةَ مَرَّةٍ)","c":1,"r":"أخرجه مسلم 4/ 2075 قال ابن الأثير: (ليغان على قلبي) أي ليغطى ويغشى والمراد به: السهو؛ لأنه كان صلّى اللّه عليه وسلّم لا يزال في مزيد من الذكر والقربة ودوام المراقبة فإذا سها عن شيء منها في بعض الأوقات، أو نسي، عدّه ذنبا على نفسه ففزع إلى الاستغفار. انظر جامع الأصول 4/ 386"}]},{"i":130,"t":"فَضْلُ التَّسْبِيحِ وَالتَّحْمِيدِ، وَالتَّهْلِيلِ، وَالتَّكْبِيرِ","a":[{"t":"قَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (مَنْ قَالَ: سُبْحَانَ اللَّهِ وَبِحَمْدِهِ فِي يَوْمٍ مِائَةَ مَرَّةٍ حُطَّتْ خَطَايَاهُ وَلَوْ كَانَتْ مِثْلَ زَبَدِ البَحْرِ)","c":100,"r":"البخاري 7/ 168 ومسلم 4/ 2071، وانظر: فضل من قالها مائة مرّة إذا أصبح وإذا أمسى ص 31 من هذا الكتاب."},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (مَنْ قَالَ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ المُلْكُ، وَلَهُ الحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، عَشْرَ مِرَارٍ، كَانَ كَمَنْ أَعْتَقَ أَرْبَعَةَ أَنْفُسٍ مِنْ وَلَدِ إِسْمَاعِيلَ)","c":10,"r":"البخاري 7/ 67 ومسلم بلفظه 4/ 2071، وانظر فضل من قالها في اليوم مائة مرّة ص 33 من هذا الكتاب"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (كَلِمَتَانِ خَفِيفَتَانِ عَلَى اللِّسَانِ، ثَقِيلَتَانِ فِي المِيزَانِ، حَبِيبَتَانِ إِلَى الرَّحْمَانِ: سُبْحَانَ اللَّهِ وَبِحَمْدِهِ سُبْحَانَ اللَّهِ العَظِيمِ)","c":1,"r":"البخاري 7/ 168 ومسلم 4/ 2072"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (لَأَنْ أَقُولَ سُبْحَانَ اللَّهِ، وَالحَمْدُ لِلَّهِ، وَلَا إِلَهَ إِلَّا اللَّهُ، وَاللَّهُ أَكْبَرُ، أَحَبُّ إِلَيَّ مِمَّا طَلَعَتْ عَلَيْهِ الشَّمْسُ)","c":1,"r":"مسلم 4/ 2072"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (أَيَعْجِزُ أَحَدُكُمْ أَنْ يَكْسِبَ كُلَّ يَوْمٍ أَلْفَ حَسَنَةٍ؟) فَسَأَلَهُ سَائِلٌ مِنْ جُلَسَائِهِ: كَيْفَ يَكْسِبُ أَحَدُنَا أَلْفَ حَسَنَةٍ؟ قَالَ: (يُسَبِّحُ مِائَةَ تَسْبِيحَةٍ، فَيُكْتَبُ لَهُ أَلْفُ حَسَنَةٍ أَوْ يُحَطُّ عَنْهُ أَلْفُ خَطِيئَةٍ)","c":1,"r":"مسلم 4/ 2073"},{"t":"مَنْ قَالَ: سُبْحَانَ اللَّهِ العَظِيمِ وَبِحَمْدِهِ غُرِسَتْ لَهُ نَخْلَةٌ فِي الجَنَّةِ","c":1,"r":"أخرجه الترمذي 5/ 511 والحاكم 1/ 501 وصحّحه ووافقه الذهبي، وانظر صحيح الجامع 5/ 531 وصحيح الترمذي 3/ 160"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (يَا عَبْدَ اللَّهِ بْنَ قَيْسٍ أَلَا أَدُلُّكَ عَلَى كَنْزٍ مِنْ كُنُوزِ الجَنَّةِ؟) فَقُلْتُ: بَلَى يَا رَسُولَ اللَّهِ، قَالَ: (قُلْ: لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ)","c":1,"r":"البخاري مع الفتح 11/ 213 ومسلم 4/ 2076"},{"t":"وَقَالَ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: (أَحَبُّ الكَلَامِ إِلَى اللَّهِ أَرْبَعٌ: سُبْحَانَ اللَّهِ، وَالحَمْدُ لِلَّهِ، وَلَا إِلَهَ إِلَّا اللَّهُ، وَاللَّهُ أَكْبَرُ، لَا يَضُرُّكَ بِأَيِّهِنَّ بَدَأْتَ)","c":1,"r":"مسلم 3/ 1685"},{"t":"جَاءَ أَعْرَابِيٌّ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَالَ: عَلِّمْنِي كَلَامًا أَقُولُهُ، قَالَ: (قُلْ: لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، اللَّهُ أَكْبَرُ كَبِيرًا، وَالحَمْدُ لِلَّهِ كَثِيرًا، سُبْحَانَ اللَّهِ رَبِّ العَالَمِينَ، لَاحَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ العَزِيزِ الحَكِيمِ) قَالَ: فَهَؤُلَاءِ لِرَبِّي فَمَا لِي؟ قَالَ: (قُلْ: اللَّهُمَّ اِغْفِرْ لِي، وَاِرْحَمْنِي، وَاِهْدِنِي، وَارْزُقْنِي)","c":1,"r":"مسلم 4/ 2072 وزَادَ أبو داود: فلمّا ولّى الأعرابي قال النّبي صلّى اللّه عليه وسلّم: (لقد ملأ يديه من الخير) 1/ 220"},{"t":"كَانَ الرَّجُلُ إِذَا أَسْلَمَ عَلَّمَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الصَّلَاةَ ثُمَّ أَمَرَهُ أَنْ يَدْعُو بِهَؤُلَاءِ الكَلِمَاتِ: (اللَّهُمَّ اغْفِرْ لِي، وَارْحَمْنِي، وَاهْدِنِي، وَعَافِنِي وَارْزُقْنِي)","c":1,"r":"مسلم 4/ 2073 في رواية مسلم: \"فإنّ هؤلاء تجمع لك دنياك وآخرتك\""},{"t":"إِنَّ أَفْضَلَ الدُّعَاءِ: الحَمْدُ لِلَّهِ، وَأَفْضَلَ الذِّكْرِ: لَا إِلَهَ إِلَّا اللَّهُ","c":1,"r":"الترمذي 5/ 462 وابن ماجة 2/ 1249 والحاكم 1/ 503 وصحّحه ووافقه الذهبي وانظر صحيح الجامع 1/ 362"},{"t":"البَاقِيَاتُ الصَّالِحَاتُ: سُبْحَانَ اللَّهِ، وَالحَمْدُ لِلَّهِ، وَلَا إِلَهَ إِلَّا اللَّهُ، وَاللَّهُ أَكْبَرُ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ","c":1,"r":"أحمد برقم 513 بترتيب أحمد شاكر وإسناده صحيح وانظر مجمع الزوائد 1/ 297، وعزاه ابن حجر في بلوغ المرام من رواية أبي سعيد إلى النّسائي وقال: صحّحه ابن حبان والحاكم"}]},{"i":131,"t":"كَيْفَ كَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُسَبِّحُ؟","a":[{"t":"عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو رَضِيَ اللَّهُ عَنْهُمَا قَالَ: (رَأَيْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَعْقِدُ التَّسْبِيحَ بِيَمِينِهِ)","c":1,"r":"أخرجه أبو داود بلفظه 2/ 81 والترمذي 5/ 521 وانظر صحيح الجامع 4/ 271 برقم 4865"}]},{"i":132,"t":"مِنْ أَنْوَاعِ الخَيْرِ وَالآدَابِ الجَامِعَةِ","a":[{"t":"إِذَا كَانَ جُنْحُ اللَّيْلِ - أَوْ أَمْسَيْتُمْ - فَكُفُّوا صِبْيَانَكُمْ؛ فَإِنَّ الشَّيَاطِينَ تَنْتَشِرُ حِينَئِذٍ، فَإِذَا ذَهَبَ سَاعَةٌ مِنَ اللَّيْلِ فَخَلُّوهُمْ، وَأَغْلِقُوا الأَبْوَابَ وَاذْكُرُوا اِسْمَ اللَّهِ، فَإِنَّ الشَّيْطَانَ لَا يَفْتَحُ بَابًا مُغْلَقًا، وَأَوْكُوا قِرَبَكُمْ وَاذْكُرُوا اِسْمَ اللَّهِ، وَخَمِّرُوا آنِيَتَكُمْ وَاذْكُرُوا اِسْمَ اللَّهِ، وَلَوْ أَنْ تَعْرُضُوا عَلَيْهَا شَيْئًا، وَأَطْفِئُوا مَصَابِيحَكُمْ\r\nوَصَلَّى اللَّهُ وَسَلَّمَ وَبَارَكَ عَلَى نَبِيِّنَا مُحَمَّدٍ وَعَلَى آلِهِ وَأَصْحَابِهِ أَجْمَعِينَ","c":1,"r":"البخاري مع الفتح 10/ 88 ومسلم 3/ 1595"}]}]
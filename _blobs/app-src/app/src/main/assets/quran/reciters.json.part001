i","m":[{"id":72,"ar":"حفص عن عاصم - مرتل","en":"Rewayat Hafs A'n Assem - Murattal","s":"https://cdn.mp3quran.net/audio/abdulwali-arkani/r1/","n":114,"l":"","t":11}]},{"id":73,"ar":"علي أبو هاشم","en":"Ali Abo-Hashim","m":[{"id":73,"ar":"حفص عن عاصم - مرتل","en":"Rewayat Hafs A'n Assem - Murattal","s":"https://cdn.mp3quran.net/audio/ali-abuhashim/r1/","n":14,"l":"11,12,18,19,21,25,50,51,52,53,54,55,56,57","t":11}]},{"id":74,"ar":"علي بن عبدالرحمن الحذيفي","en":"Ali Alhuthaifi","m":[{"id":305,"ar":"شعبة  عن عاصم - مرتل","en":"Sho'bah A'n Asim - Murattal","s":"https://cdn.mp3quran.net/audio/ali-hudhaifi/r3/","n":114,"l":"","t":151},{"id":75,"ar":"قالون عن نافع - مرتل","en":"Rewayat Qalon A'n Nafi' - Murattal","s":"https://cdn.mp3quran.net/audio/ali-hudhaifi/r2/","n":114,"l":"","t":51},{"id":74,"ar":"حفص عن عاصم - مرتل","en":"Rewayat Hafs A'n Assem - Murattal","s":"https://cdn.mp3quran.net/audio/ali-hudhaifi/r1/","n":114,"l":"","t":11}]},{"id":76,"ar":"علي جابر","en":"Ali Jaber","m":[{"id":76,"ar":"حفص عن عاصم - مرتل","en":"Rewayat Hafs A'n Assem - Murattal","s":"https://cdn.mp3quran.net/audio/ali-jaber/r1/","n":114,"l":"","t":11}]},{"id":77,"ar":"علي حجاج السويسي","en":"Ali Hajjaj Alsouasi","m":[{"id":77,"ar":"حفص عن عاصم - مرتل","en":"Rewayat Hafs A'n Assem - Murattal","s":"https://cdn.mp3quran.net/audio/ali-souissi/r1/","n":114,"l":"","t":11}]},{"id":78,"ar":"عماد زهير حافظ","en":"Emad Hafez","m":[{"id":78,"ar":"حفص عن عاصم - مرتل","en":"Rewayat Hafs A'n Assem - Murattal","s":"https://cdn.mp3quran.net/audio/imad-hafez/r1/","n":114,"l":"","t":11}]},{"id":79,"ar":"عبدالعزيز التركي","en":"Abdulaziz Alturki","m":[{"id":282,"ar":"حفص عن عاصم - مرتل","en":"Rewayat Hafs A'n Assem - Murattal","s":"https://cdn.mp3quran.net/audio/abdulaziz-turki/r1/","n":114,"l":"","t":11}]},{"id":8,"ar":"أحمد صابر","en":"Ahmad Saber","m":[{"id":8,"ar":"حفص عن عاصم - مرتل","en":"Rewayat Hafs A'n Assem - Murattal","s":"https://cdn.mp3quran.net/audio/ahmad-saber/r1/","n":114,"l":"","t":11}]},{"